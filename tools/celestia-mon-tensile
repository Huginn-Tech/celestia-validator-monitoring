#!/usr/bin/python3 -I
"""celestia-mon-tensile: the validator's Fibre endpoint as seen from outside, and its blobs, from Tensile.

Tensile (https://tensile.huginn.tech) is a Fibre observer that dials every validator's Fibre
endpoint, the host registered on chain in x/valaddr, from outside the validator's network, and
records every settled blob: the validators it assigned rows to, the endorsements it carries, and
whether each validator later returned the rows it signed for. This service reads the validator's
status from Tensile's API every interval and serves it as Prometheus metrics: the registered
endpoint, whether Tensile reached it (TCP, TLS and the validator's identity) at its last check,
and when that check ran, which FibreDown uses; and the blobs the network assigned to the
validator, which FibreNotServing compares with Fibre's own uploads.

A Tensile that does not send signing.last_assigned_at gives only the number of blobs assigned in
its last 24 hours. The time of the newest one is then the time of Tensile's newest block (/tip) at
the read at which that number rose: the blob settled in a block after the one of the read before,
so that time is late by at most the time between two reads. A rise counts only when Tensile's record
reached the chain's head at that read and at the one before, so a Tensile catching up after its own
outage cannot look like new blobs. The time is absent after a start until the first rise: nothing
is kept on disk.

  celestia-mon-tensile --config FILE [--once]

Only the Python standard library is used; the API needs no key.
"""

import argparse
import datetime
import json
import re
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

USER_AGENT = "celestia-mon-tensile (https://github.com/s0urledd/celestia-validator-monitoring)"


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def epoch(text):
    """RFC 3339 time (nanoseconds allowed) as Unix seconds; None when absent or unreadable."""
    if not text or not isinstance(text, str):
        return None
    m = re.fullmatch(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.(\d+))?(Z|[+-]\d\d:\d\d)", text)
    if not m:
        return None
    zone = "+00:00" if m.group(3) == "Z" else m.group(3)
    t = datetime.datetime.fromisoformat(m.group(1) + zone).timestamp()
    return t + (float("0." + m.group(2)) if m.group(2) else 0.0)


def esc(value):
    return str(value).replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")


class State:
    """The latest reading, rendered as Prometheus text."""

    def __init__(self):
        self.lock = threading.Lock()
        self.last_success = 0.0
        self.errors = {}
        self.status = None
        # Without Tensile's last_assigned_at: the number of assigned blobs at the previous read, None
        # when that read's record was not current, and the time of Tensile's newest block at the last
        # read at which it rose.
        self.assigned = None
        self.assigned_at = None

    def ok(self, status):
        with self.lock:
            self.status = status
            self.last_success = time.time()

    def error(self, reason):
        with self.lock:
            self.errors[reason] = self.errors.get(reason, 0) + 1

    def count_assigned(self, assigned, tip):
        """tip: the time of Tensile's newest block when its record is current, else None. The newest
        assigned blob settled at the latest by that block when the number of assigned blobs rose since
        the previous read and the record was current at both reads. A rise can be missed, when as
        many assignments leave Tensile's 24 hours as arrive between two reads, but never invented."""
        with self.lock:
            if tip is not None and self.assigned is not None and assigned > self.assigned:
                self.assigned_at = tip
            self.assigned = assigned if tip is not None else None

    def render(self):
        with self.lock:
            out = [
                "# HELP celestia_mon_tensile_last_success_timestamp_seconds Unix time of the last read of Tensile that worked, 0 before the first.",
                "# TYPE celestia_mon_tensile_last_success_timestamp_seconds gauge",
                f"celestia_mon_tensile_last_success_timestamp_seconds {self.last_success}",
                "# HELP celestia_mon_tensile_errors_total Failed reads of Tensile's API.",
                "# TYPE celestia_mon_tensile_errors_total counter",
            ]
            out += [f'celestia_mon_tensile_errors_total{{reason="{r}"}} {n}' for r, n in sorted(self.errors.items())]
            s = self.status
            if s is None:
                return "\n".join(out) + "\n"
            endpoint = esc(s.get("host") or "")
            out += [
                "# HELP celestia_mon_fibre_registered 1 when the validator has a Fibre host registered on chain (endpoint), 0 when none.",
                "# TYPE celestia_mon_fibre_registered gauge",
                f'celestia_mon_fibre_registered{{endpoint="{endpoint}"}} {1 if endpoint else 0}',
            ]
            if endpoint and s.get("reachable") is not None:
                out += [
                    "# HELP celestia_mon_fibre_reachable 1 when Tensile completed TCP, TLS and the identity check at its last check.",
                    "# TYPE celestia_mon_fibre_reachable gauge",
                    f'celestia_mon_fibre_reachable{{endpoint="{endpoint}"}} {1 if s["reachable"] else 0}',
                ]
            if endpoint:
                out += [
                    "# HELP celestia_mon_fibre_identity_verified 1 when the endpoint's TLS identity is endorsed by the validator's consensus key.",
                    "# TYPE celestia_mon_fibre_identity_verified gauge",
                    f'celestia_mon_fibre_identity_verified{{endpoint="{endpoint}"}} {1 if s.get("identity_status") == "verified" else 0}',
                ]
            check = s.get("last_endpoint_check") or {}
            at = epoch(check.get("at"))
            if endpoint and at is not None:
                out += [
                    "# HELP celestia_mon_fibre_last_check_timestamp_seconds Unix time of Tensile's last check of the endpoint.",
                    "# TYPE celestia_mon_fibre_last_check_timestamp_seconds gauge",
                    f'celestia_mon_fibre_last_check_timestamp_seconds{{endpoint="{endpoint}"}} {at}',
                    "# HELP celestia_mon_fibre_last_check_info The outcome of Tensile's last check of the endpoint.",
                    "# TYPE celestia_mon_fibre_last_check_info gauge",
                    f'celestia_mon_fibre_last_check_info{{endpoint="{endpoint}",outcome="{esc(check.get("outcome") or "")}"}} 1',
                ]
            # The validator's blobs: facts about the validator, not the endpoint, so no endpoint label
            # (a new host must not split the series).
            sig = s.get("signing") if isinstance(s.get("signing"), dict) else {}
            obl = s.get("obligations") if isinstance(s.get("obligations"), dict) else {}
            if "last_assigned_at" in sig:
                assigned_at = epoch(sig["last_assigned_at"])
            else:
                assigned_at = self.assigned_at if sig else None
            for name, at, text in (
                    ("celestia_mon_fibre_last_assigned_timestamp_seconds", assigned_at,
                     "Unix time of the newest settled blob that assigned rows to the validator, from Tensile "
                     "(from a Tensile without last_assigned_at, the time of Tensile's newest block at the read "
                     "that saw their number rise)."),
                    ("celestia_mon_fibre_last_endorsed_timestamp_seconds", epoch(sig.get("last_endorsed_at")),
                     "Unix time of the newest settled blob that carries the validator's endorsement, from Tensile.")):
                if at is not None:
                    out += [f"# HELP {name} {text}", f"# TYPE {name} gauge", f"{name} {at}"]
            if isinstance(sig.get("assigned"), int):
                out += [
                    "# HELP celestia_mon_fibre_blobs_assigned_24h Blobs settled in Tensile's last 24 hours that assigned rows to the validator.",
                    "# TYPE celestia_mon_fibre_blobs_assigned_24h gauge",
                    f"celestia_mon_fibre_blobs_assigned_24h {sig['assigned']}",
                    "# HELP celestia_mon_fibre_blobs_endorsed_24h Of those, blobs that settled with the validator's endorsement.",
                    "# TYPE celestia_mon_fibre_blobs_endorsed_24h gauge",
                    f"celestia_mon_fibre_blobs_endorsed_24h {int(sig.get('signed') or 0)}",
                ]
            if isinstance(obl.get("served"), int):
                out += [
                    "# HELP celestia_mon_fibre_obligations_24h Tensile's reads of rows the validator signed for, of blobs settled in its last 24 hours, by outcome.",
                    "# TYPE celestia_mon_fibre_obligations_24h gauge",
                    f'celestia_mon_fibre_obligations_24h{{outcome="served"}} {obl["served"]}',
                    f'celestia_mon_fibre_obligations_24h{{outcome="broken"}} {int(obl.get("broken") or 0)}',
                ]
            return "\n".join(out) + "\n"


def serve(listen, state):
    host, _, port = listen.rpartition(":")

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path != "/metrics":
                self.send_error(404)
                return
            body = state.render().encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; version=0.0.4")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *args):
            pass

    server = ThreadingHTTPServer((host, int(port)), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()


def get(url):
    """The JSON answer to a GET of url."""
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=20) as resp:
        return json.load(resp)


def current(api, state):
    """The time of Tensile's newest block (/tip) when its record reaches the chain's head: that block is
    less than 2 minutes older than Tensile's clock. None when it does not, or the tip cannot be read."""
    try:
        tip = get(api + "/tip")
    except (urllib.error.URLError, TimeoutError, OSError, ValueError) as e:
        state.error("tip")
        log(f"cannot read Tensile's tip at {api}/tip: {e}")
        return None
    if not isinstance(tip, dict):
        return None
    server, block = epoch(tip.get("server_time")), epoch(tip.get("block_time"))
    return block if server is not None and block is not None and server - block < 120 else None


def read(cfg, state):
    api = cfg["api"].rstrip("/")
    url = api + "/validators/" + urllib.parse.quote(cfg["validator"]) + "/status"
    try:
        status = get(url)
    except urllib.error.HTTPError as e:
        state.error("not_found" if e.code == 404 else "http")
        hint = ": check celestia_mon_tensile.validator and the network of celestia_mon_tensile.api" if e.code == 404 else ""
        log(f"Tensile answered {e.code} for {url}{hint}")
        return
    except (urllib.error.URLError, TimeoutError, OSError, ValueError) as e:
        state.error("network")
        log(f"cannot read Tensile at {url}: {e}")
        return
    if not isinstance(status, dict) or "host" not in status:
        state.error("format")
        log(f"Tensile's answer for {url} has no host field")
        return
    sig = status.get("signing")
    if isinstance(sig, dict) and "last_assigned_at" not in sig and isinstance(sig.get("assigned"), int):
        state.count_assigned(sig["assigned"], current(api, state))
    state.ok(status)


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--config", required=True)
    parser.add_argument("--once", action="store_true", help="read Tensile once, print the metrics and exit")
    args = parser.parse_args()
    with open(args.config) as f:
        cfg = json.load(f)
    state = State()
    if args.once:
        read(cfg, state)
        sys.stdout.write(state.render())
        return
    serve(cfg["listen"], state)
    while True:
        read(cfg, state)
        time.sleep(cfg["interval_seconds"])


if __name__ == "__main__":
    main()
