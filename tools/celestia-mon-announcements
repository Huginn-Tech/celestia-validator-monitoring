#!/usr/bin/python3 -I
"""celestia-mon-announcements: Celestia's announcements as alerts.

Reads the Discord channels named in the configuration (channels on the operator's own server
that follow Celestia's announcement channels) and posts each new message to Alertmanager as
one CelestiaAnnouncement alert, so it reaches the receivers like any other page or message
alert. The first read of a channel only notes its newest message: nothing older is sent.
Messages are posted one by one, oldest first; one that cannot be read, or that Alertmanager
refuses as invalid, is logged and passed over, so it cannot hold back the ones after it. No
redirect is followed, and no answer larger than MAX_BODY is read.

  celestia-mon-announcements --config FILE [--once]

The bot token and the API password come from systemd's credentials (LoadCredential):
discord-token and api-password in $CREDENTIALS_DIRECTORY. Only the Python standard library
is used. Prometheus scrapes the service's own metrics on the configured listen address.
"""

import argparse
import base64
import datetime
import http.client
import json
import os
import re
import sys
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

USER_AGENT = "DiscordBot (https://github.com/Huginn-Tech/celestia-validator-monitoring, 1)"
# Telegram takes 4096 characters per message; the channel's name above the text needs some.
MAX_TEXT = 3500
# Discord's flag on a message posted from a channel this one follows (IS_CROSSPOST).
CROSSPOST = 2
# The largest answer read, in bytes: 50 messages take far less, and a larger one is refused
# rather than read into memory.
MAX_BODY = 1 << 20


def log(msg):
    print(msg, file=sys.stderr, flush=True)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """Follows no redirect: urlopen raises the 3xx as an HTTPError, so the bot token and the API
    password only ever go to the URLs of the configuration."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


OPENER = urllib.request.build_opener(NoRedirect)


def read_json(resp):
    """The JSON of an answer of at most MAX_BODY bytes; ValueError for a larger one or no JSON."""
    body = resp.read(MAX_BODY + 1)
    if len(body) > MAX_BODY:
        raise ValueError(f"the answer is larger than {MAX_BODY} bytes")
    # JSON nested deeper than Python's recursion limit, well inside MAX_BODY, raises RecursionError,
    # which no caller expects: it would end the poll in main(), and the channels after this one.
    try:
        return json.loads(body)
    except RecursionError:
        raise ValueError("the answer's JSON is nested too deeply to read") from None


class Metrics:
    """The service's metrics, served as Prometheus text."""

    def __init__(self, channels):
        self.lock = threading.Lock()
        # 0 until the first successful read, so an alert also fires when no read ever works.
        self.last_success = {c: 0.0 for c in channels}
        self.forwarded = {c: 0 for c in channels}
        self.errors = {}

    def success(self, channel):
        with self.lock:
            self.last_success[channel] = time.time()

    def forward(self, channel, forwarded):
        with self.lock:
            self.forwarded[channel] += forwarded

    def error(self, channel, reason):
        with self.lock:
            key = (channel, reason)
            self.errors[key] = self.errors.get(key, 0) + 1

    def render(self):
        with self.lock:
            out = [
                "# HELP celestia_mon_announcements_last_success_timestamp_seconds "
                "Unix time of the last read of the channel that worked, 0 before the first.",
                "# TYPE celestia_mon_announcements_last_success_timestamp_seconds gauge",
            ]
            out += [f'celestia_mon_announcements_last_success_timestamp_seconds{{channel="{c}"}} {t}'
                    for c, t in sorted(self.last_success.items())]
            out += [
                "# HELP celestia_mon_announcements_forwarded_total Announcements posted to Alertmanager.",
                "# TYPE celestia_mon_announcements_forwarded_total counter",
            ]
            out += [f'celestia_mon_announcements_forwarded_total{{channel="{c}"}} {n}'
                    for c, n in sorted(self.forwarded.items())]
            out += [
                "# HELP celestia_mon_announcements_errors_total Failed reads of a channel or posts to Alertmanager.",
                "# TYPE celestia_mon_announcements_errors_total counter",
            ]
            out += [f'celestia_mon_announcements_errors_total{{channel="{c}",reason="{r}"}} {n}'
                    for (c, r), n in sorted(self.errors.items())]
            return "\n".join(out) + "\n"


def serve_metrics(listen, metrics):
    host, _, port = listen.rpartition(":")

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path != "/metrics":
                self.send_error(404)
                return
            body = metrics.render().encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; version=0.0.4")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *args):
            pass

    server = ThreadingHTTPServer((host, int(port)), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()


def credential(name):
    directory = os.environ.get("CREDENTIALS_DIRECTORY")
    if not directory:
        sys.exit(f"no {name}: start it through its systemd unit, which passes the credentials")
    with open(os.path.join(directory, name)) as f:
        return f.read().strip()


class DiscordError(Exception):
    def __init__(self, reason, text, retry_after=0):
        super().__init__(text)
        self.reason = reason
        self.retry_after = retry_after


def discord_get(api, token, path):
    req = urllib.request.Request(api + path, headers={"Authorization": "Bot " + token, "User-Agent": USER_AGENT})
    try:
        with OPENER.open(req, timeout=20) as resp:
            return read_json(resp)
    except urllib.error.HTTPError as e:
        try:
            detail = json.loads(e.read(MAX_BODY))
        except (ValueError, RecursionError, AttributeError, OSError, http.client.HTTPException):
            detail = {}
        if not isinstance(detail, dict):
            detail = {}
        message = str(detail.get("message", e.reason))[:200]
        if 300 <= e.code < 400:
            raise DiscordError("http", f"Discord answered {e.code} {message}, a redirect, which is not followed: "
                               "check celestia_mon_announcements_discord_api") from None
        if e.code == 401:
            raise DiscordError("unauthorized", "Discord refused the bot token (401): put a valid "
                               "celestia_mon_discord_bot_token in the monitor's secrets "
                               "(sudo ./install.sh --edit-secrets) or its vault") from None
        if e.code == 403:
            raise DiscordError("forbidden", f"Discord answered 403 {message}: give the bot View Channel "
                               "and Read Message History in this channel") from None
        if e.code == 404:
            raise DiscordError("not_found", f"Discord answered 404 {message}: check the channel ID, "
                               "and that the bot is on that server") from None
        if e.code == 429:
            try:
                retry_after = min(max(float(detail.get("retry_after", 5)), 0.0), 3600.0)
            except (TypeError, ValueError):
                retry_after = 5.0
            raise DiscordError("rate_limited", "Discord rate-limits the bot", retry_after) from None
        raise DiscordError("http", f"Discord answered {e.code} {message}") from None
    except (urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError) as e:
        raise DiscordError("network", f"cannot reach Discord: {e}") from None
    except ValueError as e:
        raise DiscordError("format", f"Discord's answer to {path.split('?')[0]} is not readable: {e}") from None


def clean(text):
    """Discord markup as plain text, without pings."""
    def timestamp(m):
        # A time Python cannot hold (too far off) stays as Discord wrote it.
        try:
            t = datetime.datetime.fromtimestamp(int(m.group(1)), datetime.timezone.utc)
        except (ValueError, OverflowError, OSError):
            return m.group(0)
        return t.strftime("%Y-%m-%d %H:%M UTC")

    text = re.sub(r"<t:(\d+)(?::[tTdDfFR])?>", timestamp, text)
    text = re.sub(r"<@&\d+>|@everyone|@here", "", text)
    text = re.sub(r"<@!?\d+>", "@user", text)
    text = re.sub(r"<#\d+>", "#channel", text)
    text = re.sub(r"<a?:(\w+):\d+>", r":\1:", text)
    text = re.sub(r"<(https?://[^>\s]+)>", r"\1", text)
    text = re.sub(r"[ \t]+\n", "\n", text)
    text = re.sub(r"\n{3,}", "\n\n", text).strip()
    return text


def message_text(msg):
    parts = [msg.get("content") or ""]
    for embed in msg.get("embeds") or []:
        parts += [embed.get("title") or "", embed.get("description") or ""]
    parts += [a.get("filename", "") for a in msg.get("attachments") or []]
    text = clean("\n\n".join(p for p in parts if p))
    if len(text) > MAX_TEXT:
        text = text[:MAX_TEXT].rstrip() + " … (continues on Discord)"
    return text or "(no text: open it on Discord)"


def message_link(msg, guild, channel):
    # A message from a followed channel (flag IS_CROSSPOST) links to the original.
    ref = msg.get("message_reference") or {}
    if msg.get("flags", 0) & CROSSPOST and ref.get("guild_id") and ref.get("channel_id") and ref.get("message_id"):
        return f"https://discord.com/channels/{ref['guild_id']}/{ref['channel_id']}/{ref['message_id']}"
    return f"https://discord.com/channels/{guild}/{channel}/{msg['id']}"


def iso(t):
    return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def alert(cfg, channel, guild, msg):
    # A followed channel posts as "<server> #<channel>", which names the network.
    source = ((msg.get("author") or {}).get("username") or "Discord")[:100]
    now = time.time()
    link = message_link(msg, guild, channel["id"])
    return {
        "labels": {
            "alertname": "CelestiaAnnouncement",
            "severity": channel["severity"],
            "host": cfg["host"],
            "source": source,
            "announcement": msg["id"],
        },
        "annotations": {
            "summary": f"Celestia announcement from {source}",
            "description": message_text(msg),
            "link": link,
        },
        "startsAt": iso(now),
        "endsAt": iso(now + 60 * cfg["active_minutes"]),
        "generatorURL": link,
    }


def post_alerts(cfg, password, alerts):
    login = base64.b64encode(f"{cfg['api_user']}:{password}".encode()).decode()
    req = urllib.request.Request(
        cfg["alertmanager_url"].rstrip("/") + "/api/v2/alerts",
        data=json.dumps(alerts).encode(),
        headers={"Content-Type": "application/json", "Authorization": "Basic " + login},
        method="POST")
    with OPENER.open(req, timeout=20) as resp:
        if resp.status != 200:
            raise urllib.error.HTTPError(req.full_url, resp.status, "unexpected status", resp.headers, None)


def load_state(path):
    try:
        with open(path) as f:
            state = json.load(f)
    except FileNotFoundError:
        return {}
    except ValueError:
        state = None
    if not isinstance(state, dict):
        log(f"{path} is not a JSON object: starting over (no older messages are sent)")
        return {}
    return state


def save_state(path, state):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.replace(tmp, path)


def messages(answer):
    """The messages of a Discord answer, oldest first. One without a numeric ID cannot be ordered
    or read after, so it is left out."""
    if not isinstance(answer, list):
        raise DiscordError("format", "Discord answered with no list of messages")
    msgs = [m for m in answer if isinstance(m, dict) and re.fullmatch(r"[0-9]{1,20}", str(m.get("id", "")))]
    for m in msgs:
        m["id"] = str(m["id"])
    return sorted(msgs, key=lambda m: int(m["id"]))


def crossposted(msg):
    flags = msg.get("flags", 0)
    return isinstance(flags, int) and bool(flags & CROSSPOST)


def forward(cfg, password, channel, guild, msg, metrics):
    """Posts one announcement to Alertmanager: "sent"; "passed" when it cannot be read or
    Alertmanager refuses it as invalid (400), so it cannot hold back the ones after it; "wait"
    when Alertmanager cannot take it now, so it and the ones after it are sent at a later read."""
    cid = channel["id"]
    try:
        posted = alert(cfg, channel, guild, msg)
    except (AttributeError, KeyError, TypeError, ValueError) as e:
        metrics.error(cid, "format")
        log(f"channel {cid}: message {msg['id']} cannot be read, passed over: {e!r}")
        return "passed"
    try:
        post_alerts(cfg, password, [posted])
    except urllib.error.HTTPError as e:
        metrics.error(cid, "alertmanager")
        if e.code == 400:
            log(f"channel {cid}: Alertmanager refused announcement {msg['id']} as invalid (400), passed over")
            return "passed"
        log(f"channel {cid}: Alertmanager answered {e.code} for announcement {msg['id']}, retrying")
        return "wait"
    except (urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError) as e:
        metrics.error(cid, "alertmanager")
        log(f"channel {cid}: Alertmanager did not take announcement {msg['id']}, retrying: {e}")
        return "wait"
    return "sent"


def poll(cfg, token, password, state, guilds, metrics):
    """One read of every channel. Returns the seconds Discord asks to wait, if any."""
    wait = 0
    for channel in cfg["channels"]:
        cid = channel["id"]
        try:
            if cid not in guilds:
                info = discord_get(cfg["discord_api"], token, f"/channels/{cid}")
                if not isinstance(info, dict):
                    raise DiscordError("format", "Discord answered the channel with no object")
                guilds[cid] = str(info.get("guild_id") or "@me")
            last = state.get(cid)
            if last is None:
                newest = messages(discord_get(cfg["discord_api"], token, f"/channels/{cid}/messages?limit=1"))
                state[cid] = newest[-1]["id"] if newest else "0"
                save_state(cfg["state_file"], state)
                log(f"channel {cid}: reading from now on (older messages are not sent)")
                metrics.success(cid)
                continue
            msgs = messages(discord_get(cfg["discord_api"], token, f"/channels/{cid}/messages?after={last}&limit=50"))
            # One by one, oldest first, and the channel's place moves past each message dealt with.
            # Only what a followed channel posted is an announcement. Anything else in the channel
            # (people, bots, a webhook, such as an alert receiver that posts there) is passed over,
            # or alerts posted to this channel would come back as announcements.
            sent = other = 0
            outcome = "sent"
            for m in msgs:
                if not crossposted(m):
                    other += 1
                else:
                    outcome = forward(cfg, password, channel, guilds[cid], m, metrics)
                    if outcome == "wait":
                        break
                    if outcome == "sent":
                        sent += 1
                state[cid] = m["id"]
            if sent:
                log(f"channel {cid}: sent {sent} announcement(s) to Alertmanager")
            if other:
                log(f"channel {cid}: passed over {other} message(s) not posted by a followed channel")
            if state[cid] != last:
                save_state(cfg["state_file"], state)
            metrics.forward(cid, sent)
            if outcome != "wait":
                metrics.success(cid)
        except DiscordError as e:
            metrics.error(cid, e.reason)
            log(f"channel {cid}: {e}")
            wait = max(wait, e.retry_after)
        except (AttributeError, KeyError, TypeError, ValueError) as e:
            metrics.error(cid, "format")
            log(f"channel {cid}: cannot read Discord's answer: {e!r}")
    return wait


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--config", required=True)
    parser.add_argument("--once", action="store_true", help="read every channel once and exit")
    args = parser.parse_args()
    with open(args.config) as f:
        cfg = json.load(f)
    token = credential("discord-token")
    password = credential("api-password")
    metrics = Metrics([c["id"] for c in cfg["channels"]])
    if not args.once:
        serve_metrics(cfg["listen"], metrics)
    state = load_state(cfg["state_file"])
    guilds = {}
    while True:
        # Nothing ends the loop: what goes wrong is logged, and AnnouncementsUnreadable fires if no
        # read works for 15 minutes.
        try:
            wait = poll(cfg, token, password, state, guilds, metrics)
        except Exception as e:
            log(f"the read failed: {e!r}")
            wait = 0
        if args.once:
            return
        time.sleep(max(cfg["interval_seconds"], wait))


if __name__ == "__main__":
    main()
