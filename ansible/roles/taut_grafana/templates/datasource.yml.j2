# Managed by Taut (Ansible role taut_grafana). Local changes are overwritten.
{% set taut_grafana_prom_ip = hostvars[taut_monitor_host].taut_private_ip %}
apiVersion: 1
datasources:
  - name: Prometheus
    uid: taut-prometheus
    type: prometheus
    access: proxy
    url: "http://{{ ('[' ~ taut_grafana_prom_ip ~ ']') if ':' in taut_grafana_prom_ip else taut_grafana_prom_ip }}:{{ taut_ports.prometheus }}"
    isDefault: true
    editable: false
