# Managed by Taut (role taut_grafana). Local changes are overwritten.
[Unit]
Description=Grafana (Taut)
Documentation=https://grafana.com/docs/grafana/latest/
Wants=network-online.target
After=network-online.target

[Service]
User=taut-grafana
Group=taut-grafana
WorkingDirectory={{ taut_grafana_home }}
ExecStart={{ taut_grafana_home }}/bin/grafana server \
  --homepath {{ taut_grafana_home }} \
  --config {{ taut_grafana_config_dir }}/grafana.ini
Restart=on-failure
# The private address can appear after boot (WireGuard, Tailscale): keep retrying.
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths={{ taut_grafana_data_dir }}

[Install]
WantedBy=multi-user.target
