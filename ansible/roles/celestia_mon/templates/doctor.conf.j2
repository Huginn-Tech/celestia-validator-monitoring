# Settings for celestia-mon-doctor (/usr/local/bin/celestia-mon-doctor), written by the celestia-mon playbook.
# The next playbook run overwrites this file: change the inventory instead.
# Any key can also be passed as a flag, for example --node-home /path.
{# Both plays that install doctor render this file on a host with several roles, so it may
   only use the shared celestia_mon settings and vars, groups and hostvars; anything else would make
   the two renders differ and every run report a change. #}
{% set node_hosts = celestia_mon_appd_hosts %}
{% set fibre_hosts = groups.get('fibre', []) if (celestia_mon_fibre_enabled | bool) else [] %}
{# NAME=host:port of every Fibre host that sets an endpoint: doctor accepts a registration of any of them. #}
{% set ns = namespace(endpoints=[]) %}
{% for h in groups.get('fibre', []) if hostvars[h].celestia_mon_fibre_public_endpoint | default('') %}
{% set ns.endpoints = ns.endpoints + [h ~ '=' ~ hostvars[h].celestia_mon_fibre_public_endpoint] %}
{% endfor %}
{# NAME=address (celestia_mon_private_ip) of every celestia-appd node and of every Fibre host. #}
{% set addresses = namespace(nodes=[], fibres=[]) %}
{% for h in node_hosts if hostvars[h].celestia_mon_private_ip | default('') %}
{% set addresses.nodes = addresses.nodes + [h ~ '=' ~ hostvars[h].celestia_mon_private_ip] %}
{% endfor %}
{% for h in fibre_hosts if hostvars[h].celestia_mon_private_ip | default('') %}
{% set addresses.fibres = addresses.fibres + [h ~ '=' ~ hostvars[h].celestia_mon_private_ip] %}
{% endfor %}
{# NAME=unit of every Fibre host, with the default of the rules' unit() macro: another host's
   hostvars carry no role defaults, and each host may set its own celestia_mon_units. #}
{% set units = namespace(fibres=[]) %}
{% for h in fibre_hosts %}
{% set units.fibres = units.fibres + [h ~ '=' ~ ((hostvars[h].celestia_mon_units | default({'appd': 'celestia-appd', 'fibre': 'fibre', 'tmkms': 'tmkms'}))['fibre'] | default('fibre'))] %}
{% endfor %}
roles={{ ['validator', 'backup_node', 'fibre', 'kms', 'monitor'] | select('in', group_names) | join(',') }}
inventory_host={{ inventory_hostname }}
signer={{ celestia_mon_signer }}
fibre_enabled={{ 'true' if celestia_mon_fibre_enabled else 'false' }}
appd_unit={{ celestia_mon_units.appd }}
fibre_unit={{ celestia_mon_units.fibre }}
{# install.sh --uninstall reads the three unit names here (ansible/uninstall.yml). #}
tmkms_unit={{ celestia_mon_units.tmkms | default('') }}
{% if inventory_hostname in node_hosts %}
{# doctor follows [rpc] laddr in the node's config.toml when the RPC listens on another address. #}
node_rpc_url=http://127.0.0.1:{{ celestia_mon_node_rpc_port }}
node_metrics_url=http://{{ ('[' ~ celestia_mon_private_ip ~ ']') if ':' in celestia_mon_private_ip else celestia_mon_private_ip }}:{{ celestia_mon_node_metrics_port }}/metrics
node_home={{ celestia_mon_node_home | default('') }}
{% endif %}
{# Unset, celestia_mon_data_mounts is [/]: doctor's check 10 then reads the disk of /. #}
data_mounts={{ celestia_mon_data_mounts | default(['/']) | join(',') }}
{% if inventory_hostname in groups.get('fibre', []) %}
fibre_mount={{ celestia_mon_fibre_mount | default('') }}
{% endif %}
fibre_otel_endpoint=http://127.0.0.1:{{ celestia_mon_ports.otelcol_otlp }}
fibre_public_endpoint={{ ns.endpoints | join(',') }}
{# Every Fibre host, active or standby: with two or more, a stopped Fibre unit is a standby. #}
fibre_hosts={{ fibre_hosts | join(',') }}
{# Checks 17 and 27 name the node a Fibre signs through and reads; check 25 names, in its ufw
   command for the app gRPC, the Fibre hosts that have no node of their own to read. #}
node_addresses={{ addresses.nodes | join(',') }}
fibre_addresses={{ addresses.fibres | join(',') }}
{% if inventory_hostname in groups.get('monitor', []) %}
prometheus_url=http://127.0.0.1:{{ celestia_mon_ports.prometheus }}
alertmanager_url=http://127.0.0.1:{{ celestia_mon_ports.alertmanager }}
blackbox_url=http://127.0.0.1:{{ celestia_mon_ports.blackbox }}
{# The login of Prometheus's and Alertmanager's APIs (role celestia_mon's api_password.yml). #}
api_user={{ celestia_mon_api_user }}
api_password_file={{ celestia_mon_api_password_file }}
node_hosts={{ node_hosts | join(',') }}
{# Checks 13, 19 and 24 read each Fibre host under its own unit name. #}
fibre_units={{ units.fibres | join(',') }}
{# Whether GovVoteMissing pages, as the rules have it (celestia_mon_gov_page). #}
gov_page={{ 'true' if celestia_mon_gov_page | bool else 'false' }}
{% endif %}
signer_median_max={{ celestia_mon_thresholds.signer_median_seconds }}
disk_min_free_ratio={{ celestia_mon_thresholds.disk_message_free_ratio }}
node_behind_blocks={{ celestia_mon_thresholds.node_behind_blocks | default(20) }}
private_address_regex={{ celestia_mon_private_address_regex }}
