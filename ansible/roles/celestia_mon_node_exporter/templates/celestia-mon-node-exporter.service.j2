# Managed by celestia-mon (role celestia_mon_node_exporter). Local changes are overwritten.
[Unit]
Description=Prometheus node_exporter (celestia-mon)
Documentation=https://github.com/prometheus/node_exporter
Wants=network-online.target
After=network-online.target

[Service]
User=celestia-mon-node-exporter
{# systemd unescapes backslashes and expands "$" in ExecStart, so both are doubled. #}
ExecStart={{ celestia_mon_node_exporter_binary }} \
{% if celestia_mon_host_units | length > 0 %}
    --collector.systemd \
    --collector.systemd.enable-restarts-metrics \
    --collector.systemd.enable-start-time-metrics \
    --collector.systemd.unit-include={{ celestia_mon_node_exporter_unit_include | replace('\\', '\\\\') | replace('$', '$$') }} \
{% endif %}
    --web.listen-address={{ celestia_mon_node_exporter_listen_address }}
Restart=on-failure
# The private address can appear after boot (WireGuard, Tailscale): keep retrying.
RestartSec=5s
# Lower CPU and disk priority than the Celestia services when they compete (no CPU quota),
# a soft memory target (MemoryHigh) and a hard limit well above it (MemoryMax).
Nice={{ celestia_mon_nice }}
CPUWeight={{ celestia_mon_cpu_weight }}
IOWeight={{ celestia_mon_io_weight }}
MemoryHigh={{ celestia_mon_memory.node_exporter.high }}
MemoryMax={{ celestia_mon_memory.node_exporter.max }}
# When the whole host runs out of memory, the kernel ends this service before celestia-appd,
# Fibre or tmkms.
OOMScoreAdjust=500
NoNewPrivileges=true
ProtectSystem=strict
# read-only rather than true, so the filesystem collector still sees data disks
# mounted under /home or /root.
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
SystemCallArchitectures=native
# AF_NETLINK: the netdev and arp collectors read the kernel's tables over netlink.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# No capabilities, no kernel or cgroup changes, no new namespaces, and only the system calls
# of an ordinary service (a call outside the set fails with EPERM), plus adjtimex: the timex
# collector reads the clock's sync state with it (without a capability it cannot set the clock).
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service adjtimex
SystemCallErrorNumber=EPERM
# Network traffic only with loopback, this host's private address, the monitor's and the ufw
# sources (celestia_mon_firewall_sources): no other host can scrape it, whatever the firewall.
IPAddressDeny=any
IPAddressAllow=localhost
{% for ip in celestia_mon_scrape_peers %}
IPAddressAllow={{ ip }}
{% endfor %}

[Install]
WantedBy=multi-user.target
