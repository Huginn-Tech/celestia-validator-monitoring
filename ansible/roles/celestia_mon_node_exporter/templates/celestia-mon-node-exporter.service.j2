# Managed by celestia-mon (role celestia_mon_node_exporter). Local changes are overwritten.
[Unit]
Description=Prometheus node_exporter (celestia-mon)
Documentation=https://github.com/prometheus/node_exporter
Wants=network-online.target
After=network-online.target

[Service]
User=celestia-mon-node-exporter
{# systemd unescapes backslashes and expands "$" in ExecStart, so both are doubled. #}
ExecStart={{ celestia_mon_node_exporter_binary }} \
{% if celestia_mon_host_units | length > 0 %}
    --collector.systemd \
    --collector.systemd.enable-restarts-metrics \
    --collector.systemd.enable-start-time-metrics \
    --collector.systemd.unit-include={{ celestia_mon_node_exporter_unit_include | replace('\\', '\\\\') | replace('$', '$$') }} \
{% endif %}
    --web.listen-address={{ celestia_mon_node_exporter_listen_address }}
Restart=on-failure
# The private address can appear after boot (WireGuard, Tailscale): keep retrying.
RestartSec=5s
# Lower CPU and disk priority than the Celestia services, and a memory ceiling.
Nice={{ celestia_mon_nice }}
CPUWeight={{ celestia_mon_cpu_weight }}
IOWeight={{ celestia_mon_io_weight }}
MemoryHigh={{ celestia_mon_memory.node_exporter.high }}
MemoryMax={{ celestia_mon_memory.node_exporter.max }}
NoNewPrivileges=true
ProtectSystem=strict
# read-only rather than true, so the filesystem collector still sees data disks
# mounted under /home or /root.
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
