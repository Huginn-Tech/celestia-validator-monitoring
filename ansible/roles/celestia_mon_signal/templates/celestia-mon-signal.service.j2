# Managed by celestia-mon (role celestia_mon_signal). Local changes are overwritten.
[Unit]
Description=The network's upgrade signalling and the validator's signal, from x/signal (celestia-mon)
Wants=network-online.target
After=network-online.target

[Service]
User=celestia-mon-signal
Group=celestia-mon-signal
ExecStart=/usr/bin/python3 -I {{ celestia_mon_signal_script }} --config {{ celestia_mon_signal_config }}
Restart=on-failure
RestartSec=30s
# Lower CPU and disk priority than the Celestia services when they compete (no CPU quota),
# a soft memory target (MemoryHigh) and a hard limit well above it (MemoryMax).
Nice={{ celestia_mon_nice }}
CPUWeight={{ celestia_mon_cpu_weight }}
IOWeight={{ celestia_mon_io_weight }}
MemoryHigh={{ celestia_mon_memory.signal.high }}
MemoryMax={{ celestia_mon_memory.signal.max }}
# When the whole host runs out of memory, the kernel ends this service before celestia-appd,
# Fibre or tmkms.
OOMScoreAdjust=500
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# No capabilities, no kernel or cgroup changes, no new namespaces, and only the system calls
# of an ordinary service (a call outside the set fails with EPERM).
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# No traffic with the internal ranges (celestia_mon_collector_denied) but loopback (Prometheus's
# scrapes), the DNS resolvers and the RPC addresses of its settings: an answer or a changed DNS
# record cannot send it to another host on the private network or to a cloud's metadata service.
# A node on the private network is named by its address. Public addresses stay open.
IPAddressDeny={{ celestia_mon_collector_denied | join(' ') }}
IPAddressAllow=localhost
{% for ip in (celestia_mon_resolvers + celestia_mon_signal_rpc_ips) | unique %}
IPAddressAllow={{ ip }}
{% endfor %}

[Install]
WantedBy=multi-user.target
