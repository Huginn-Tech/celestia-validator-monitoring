# Managed by celestia-mon (role celestia_mon_tensile). Local changes are overwritten.
[Unit]
Description=The validator's Fibre endpoint seen from outside, from Tensile (celestia-mon)
Wants=network-online.target
After=network-online.target

[Service]
User=celestia-mon-tensile
Group=celestia-mon-tensile
ExecStart=/usr/bin/python3 -I {{ celestia_mon_tensile_script }} --config {{ celestia_mon_tensile_config }}
Restart=on-failure
RestartSec=30s
# Lower CPU and disk priority than the Celestia services when they compete (no CPU quota),
# a soft memory target (MemoryHigh) and a hard limit well above it (MemoryMax).
Nice={{ celestia_mon_nice }}
CPUWeight={{ celestia_mon_cpu_weight }}
IOWeight={{ celestia_mon_io_weight }}
MemoryHigh={{ celestia_mon_memory.tensile.high }}
MemoryMax={{ celestia_mon_memory.tensile.max }}
# When the whole host runs out of memory, the kernel ends this service before celestia-appd,
# Fibre or tmkms.
OOMScoreAdjust=500
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# No capabilities, no kernel or cgroup changes, no new namespaces, and only the system calls
# of an ordinary service (a call outside the set fails with EPERM).
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
