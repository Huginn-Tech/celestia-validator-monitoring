# Managed by celestia-mon (role celestia_mon_otelcol). Local changes are overwritten.
# Fibre pushes metrics and traces over OTLP/HTTP to the loopback receiver; Prometheus
# scrapes the metrics on the private address. Based on celestia-app
# observability/docker/otel-collector/config.yml.
# Written for otelcol-contrib 0.160.0 and newer (metrics_transform, resource_constant_labels).

receivers:
  otlp:
    protocols:
      http:
        endpoint: "{{ celestia_mon_otelcol_otlp_endpoint }}"

processors:
  # Fibre's shard duration histograms also carry raw size attributes (upload_size,
  # shard_size), one series per size. Sum them away and keep only success.
  # Deleting the attributes instead would make the exporter keep one colliding
  # cumulative point and the counts would jump.
  metrics_transform/fibre:
    transforms:
      - include: '^fibre\.server\.(upload|download)_shard\.duration$'
        match_type: regexp
        action: update
        operations:
          - action: aggregate_labels
            label_set: [success]
            aggregation_type: sum

exporters:
  prometheus:
    endpoint: "{{ celestia_mon_otelcol_prometheus_endpoint }}"
    # Every resource attribute becomes a label.
    resource_constant_labels:
      included: ["*"]
    # Classic Prometheus names with unit and type suffixes (_seconds, _total).
    translation_strategy: UnderscoreEscapingWithSuffixes
    metric_expiration: 5m
  # Fibre sends traces to the same endpoint; accept and drop them.
  nop:

service:
  telemetry:
    metrics:
      # No internal metrics endpoint (it would open port 8888).
      level: none
  pipelines:
    metrics:
      receivers: [otlp]
      processors: [metrics_transform/fibre]
      exporters: [prometheus]
    traces:
      receivers: [otlp]
      exporters: [nop]
