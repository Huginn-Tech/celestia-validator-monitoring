# Settings for taut-doctor (/usr/local/bin/taut-doctor), written by the Taut playbook.
# The next playbook run overwrites this file: change the inventory instead.
# Any key can also be passed as a flag, for example --node-home /path.
roles={{ ['validator', 'fibre', 'kms', 'monitor'] | select('in', group_names) | join(',') }}
signer={{ taut_signer }}
fibre_enabled={{ 'true' if taut_fibre_enabled else 'false' }}
appd_unit={{ taut_units.appd }}
fibre_unit={{ taut_units.fibre }}
{% if inventory_hostname in groups.get('validator', []) %}
node_rpc_url=http://127.0.0.1:{{ taut_node_rpc_port }}
node_metrics_url=http://{{ ('[' ~ taut_private_ip ~ ']') if ':' in taut_private_ip else taut_private_ip }}:{{ taut_node_metrics_port }}/metrics
node_home={{ taut_node_home | default('') }}
{% endif %}
data_mounts={{ taut_data_mounts | default([]) | join(',') }}
{% if inventory_hostname in groups.get('fibre', []) %}
fibre_mount={{ taut_fibre_mount | default('') }}
fibre_otel_endpoint=http://127.0.0.1:{{ taut_ports.otelcol_otlp }}
{% endif %}
fibre_public_endpoint={{ (hostvars[groups['fibre'][0]].taut_fibre_public_endpoint | default('')) if groups.get('fibre', []) else '' }}
signer_median_max={{ taut_thresholds.signer_median_seconds }}
disk_min_free_ratio={{ taut_thresholds.disk_message_free_ratio }}
private_address_regex={{ taut_private_address_regex }}
