# Managed by celestia-mon (role celestia_mon_grafana). Local changes are overwritten.
{# Besides loopback, with a private celestia_mon_grafana_listen: that address (a connection from
   this host to it comes from it) and the clients in celestia_mon_grafana_clients, which the role
   checks are single private addresses of no inventory host. None with loopback. #}
{% set celestia_mon_grafana_unit_listen = celestia_mon_grafana_listen | string %}
{% set celestia_mon_grafana_unit_peers = []
   if celestia_mon_grafana_unit_listen is match(celestia_mon_loopback_address_regex)
   else ([celestia_mon_grafana_unit_listen] + celestia_mon_grafana_clients | map('string') | list) | unique | list %}
[Unit]
Description=Grafana (celestia-mon)
Documentation=https://grafana.com/docs/grafana/latest/
Wants=network-online.target
After=network-online.target

[Service]
User=celestia-mon-grafana
Group=celestia-mon-grafana
WorkingDirectory={{ celestia_mon_grafana_home }}
ExecStart={{ celestia_mon_grafana_home }}/bin/grafana server \
  --homepath {{ celestia_mon_grafana_home }} \
  --config {{ celestia_mon_grafana_config_dir }}/grafana.ini
Restart=on-failure
# The private address can appear after boot (WireGuard, Tailscale): keep retrying.
RestartSec=5s
# Lower CPU and disk priority than the Celestia services when they compete (no CPU quota),
# a soft memory target (MemoryHigh) and a hard limit well above it (MemoryMax).
Nice={{ celestia_mon_nice }}
CPUWeight={{ celestia_mon_cpu_weight }}
IOWeight={{ celestia_mon_io_weight }}
MemoryHigh={{ celestia_mon_memory.grafana.high }}
MemoryMax={{ celestia_mon_memory.grafana.max }}
# When the whole host runs out of memory, the kernel ends this service before celestia-appd,
# Fibre or tmkms.
OOMScoreAdjust=500
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# No capabilities, no kernel or cgroup changes, no new namespaces, and only the system calls
# of an ordinary service (a call outside the set fails with EPERM).
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Network traffic only with 127.0.0.1 (Prometheus, an SSH tunnel, a local reverse proxy) and,
# when Grafana listens on a private address, with that address and the machines listed in
# celestia_mon_grafana_clients: a Grafana login cannot reach other hosts through a datasource
# (the validator's RPC and gRPC ports, for example).
IPAddressDeny=any
IPAddressAllow=localhost
{% for ip in celestia_mon_grafana_unit_peers %}
IPAddressAllow={{ ip }}
{% endfor %}
ReadWritePaths={{ celestia_mon_grafana_data_dir }}

[Install]
WantedBy=multi-user.target
