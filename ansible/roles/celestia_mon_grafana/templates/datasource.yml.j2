# Managed by celestia-mon (Ansible role celestia_mon_grafana). Local changes are overwritten.
{% set celestia_mon_grafana_prom_ip = hostvars[celestia_mon_monitor_host].celestia_mon_private_ip %}
apiVersion: 1
datasources:
  - name: Prometheus
    uid: celestia-mon-prometheus
    type: prometheus
    access: proxy
    url: "http://{{ ('[' ~ celestia_mon_grafana_prom_ip ~ ']') if ':' in celestia_mon_grafana_prom_ip else celestia_mon_grafana_prom_ip }}:{{ celestia_mon_ports.prometheus }}"
    isDefault: true
    editable: false
