{#
  Rendered for the monitor host (by the celestia_mon_prometheus role, or by CI with connection local).
  Per-target values come from groups and hostvars; the shared celestia_mon_* settings are the fallback,
  because role defaults are not part of other hosts' hostvars.
#}
{% macro target(h, port) %}{% set ip = hostvars[h].celestia_mon_private_ip | string %}{{ ('[' ~ ip ~ ']') if ':' in ip else ip }}:{{ port }}{% endmacro %}
{% set validators = groups.get('validator', []) %}
{% set fibres = groups.get('fibre', []) if celestia_mon_fibre_enabled else [] %}
{# The role label names the host's inventory group, not the role it holds after a failover. #}
{% macro node_role(h) %}{{ 'validator' if h in groups.get('validator', []) else 'fibre' if h in groups.get('fibre', [])
   else 'backup_node' if h in groups.get('backup_node', []) else 'kms' }}{% endmacro %}
# Managed by celestia-mon. Local changes are overwritten on the next playbook run.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

# Blocks are deleted when either limit is reached. Set both: a retention section
# without time turns time-based retention off.
storage:
  tsdb:
    retention:
      time: {{ celestia_mon_prometheus_retention | string | to_json }}
      size: {{ celestia_mon_prometheus_retention_size | string | to_json }}

rule_files:
  - "{{ celestia_mon_prometheus_rules_dir }}/*.yml"

# Alertmanager runs on this host and listens on loopback only. It and Prometheus take only
# requests with the API password (their --web.config.file); Prometheus reads it from this file.
alerting:
  alertmanagers:
    - basic_auth:
        username: {{ celestia_mon_api_user | to_json }}
        password_file: {{ celestia_mon_api_password_file | to_json }}
      static_configs:
        - targets:
            - "127.0.0.1:{{ celestia_mon_ports.alertmanager }}"

scrape_configs:
  # Prometheus and Alertmanager themselves, on loopback: failing rule evaluations
  # and failed notifications must be visible to the alert rules.
  - job_name: prometheus
    basic_auth:
      username: {{ celestia_mon_api_user | to_json }}
      password_file: {{ celestia_mon_api_password_file | to_json }}
    static_configs:
      - targets:
          - "127.0.0.1:{{ celestia_mon_ports.prometheus }}"
        labels:
          host: {{ celestia_mon_monitor_host | to_json }}
          role: monitor

  - job_name: alertmanager
    basic_auth:
      username: {{ celestia_mon_api_user | to_json }}
      password_file: {{ celestia_mon_api_password_file | to_json }}
    static_configs:
      - targets:
          - "127.0.0.1:{{ celestia_mon_ports.alertmanager }}"
        labels:
          host: {{ celestia_mon_monitor_host | to_json }}
          role: monitor

  # celestia-appd's own metrics endpoint ([instrumentation] prometheus_listen_addr), on the
  # validator and on each backup node: the rules read which node signs from the metrics.
  - job_name: celestia-app
    static_configs:
{% for h in celestia_mon_appd_hosts %}
      - targets:
          - "{{ target(h, hostvars[h].celestia_mon_node_metrics_port | default(celestia_mon_node_metrics_port)) }}"
        labels:
          host: {{ h | to_json }}
          role: {{ 'validator' if h in validators else 'backup_node' }}
{% endfor %}
    # The node may use the celestia_ namespace; panels and rules use cometbft_.
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: "celestia_(.+)"
        target_label: __name__
        replacement: "cometbft_$1"

  # node_exporter on every Celestia host (kms hosts only with celestia_mon_kms_scrape).
  - job_name: node
    static_configs:
{% for h in (celestia_mon_appd_hosts + groups.get('fibre', []) + groups.get('kms', [])) | unique %}
{%   if h in celestia_mon_appd_hosts or h in groups.get('fibre', []) or (hostvars[h].celestia_mon_kms_scrape | default(false) | bool) %}
      - targets:
          - "{{ target(h, (hostvars[h].celestia_mon_ports | default(celestia_mon_ports)).node_exporter) }}"
        labels:
          host: {{ h | to_json }}
          role: {{ node_role(h) }}
{%   endif %}
{% endfor %}
{% if fibres | length > 0 %}

  # The OpenTelemetry collector that receives Fibre's OTLP metrics, on every Fibre host,
  # active or standby.
  - job_name: otelcol
    static_configs:
{% for h in fibres %}
      - targets:
          - "{{ target(h, (hostvars[h].celestia_mon_ports | default(celestia_mon_ports)).otelcol_prometheus) }}"
        labels:
          host: {{ h | to_json }}
          role: fibre
{% endfor %}
{% endif %}
{% if celestia_mon_announcements | default([]) | length > 0 %}

  # celestia-mon-announcements on this host: whether it still reads Celestia's announcements.
  - job_name: announcements
    static_configs:
      - targets:
          - "127.0.0.1:{{ celestia_mon_ports.announcements }}"
        labels:
          host: {{ inventory_hostname | to_json }}
          role: monitor
{% endif %}
