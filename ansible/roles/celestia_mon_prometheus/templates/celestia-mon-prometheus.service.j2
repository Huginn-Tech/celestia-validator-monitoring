# Managed by celestia-mon. Local changes are overwritten on the next playbook run.
[Unit]
Description=Prometheus (celestia-mon)
Documentation=https://prometheus.io/docs/
Wants=network-online.target
After=network-online.target

[Service]
User=celestia-mon-prometheus
Group=celestia-mon-prometheus
# Retention (time and size) is set in prometheus.yml, so a change needs only a reload.
ExecStart={{ celestia_mon_prometheus_home }}/prometheus \
  --config.file={{ celestia_mon_prometheus_config_dir }}/prometheus.yml \
  --storage.tsdb.path={{ celestia_mon_prometheus_data_dir }} \
  --web.listen-address={{ celestia_mon_prometheus_listen_address }} \
  --web.config.file={{ celestia_mon_api_web_configs.prometheus }}
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
# Lower CPU and disk priority than the Celestia services when they compete (no CPU quota),
# a soft memory target (MemoryHigh) and a hard limit well above it (MemoryMax).
Nice={{ celestia_mon_nice }}
CPUWeight={{ celestia_mon_cpu_weight }}
IOWeight={{ celestia_mon_io_weight }}
MemoryHigh={{ celestia_mon_memory.prometheus.high }}
MemoryMax={{ celestia_mon_memory.prometheus.max }}
# Go's garbage collector works harder as the process nears this limit (90% of MemoryHigh),
# before the kernel starts slowing the service down. With GOMEMLIMIT set, Prometheus skips
# its own limit, which it would take from MemoryMax.
Environment=GOMEMLIMIT={{ (0.9 * (celestia_mon_memory.prometheus.high | ansible.builtin.human_to_bytes)) | int }}
# When the whole host runs out of memory, the kernel ends this service before celestia-appd,
# Fibre or tmkms.
OOMScoreAdjust=500
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# No capabilities, no kernel or cgroup changes, no new namespaces, and only the system calls
# of an ordinary service (a call outside the set fails with EPERM).
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths={{ celestia_mon_prometheus_data_dir }}

[Install]
WantedBy=multi-user.target
