# celestia-mon alert rules, rendered by Ansible from monitoring/rules/celestia-mon.rules.yml.j2.
# Change the template or the inventory, not the rendered file. See docs/alerts.md.
{#
  Roles can move between hosts: tmkms can be pointed at a backup node, and a standby Fibre can
  be started on another host. The page alerts (NodeNotAdvancing, ValidatorNotSigning, NodePeersLow,
  FibreDown, DiskLow) therefore read which node signs and which Fibre runs from the metrics, never
  from the inventory, and ServiceDown is a message. The pages of upgrade signalling, UpgradeSignalMissing,
  and of governance votes, GovVoteMissing, read the chain through celestia-mon-signal and name no host either.
#}
{% set appd = celestia_mon_units.appd ~ '.service' %}
{% set fibre = (celestia_mon_units.fibre | default('')) ~ '.service' %}
{% set tmkms = (celestia_mon_units.tmkms | default('')) ~ '.service' %}
{% set remote = celestia_mon_signer == 'remote' %}
{# tmkms signs through several nodes on purpose (several [[validator]] entries). #}
{% set multi = remote and celestia_mon_signer_multi_node | default(false) | bool %}
{% set fibre_on = celestia_mon_fibre_enabled | bool %}
{% set th = celestia_mon_thresholds %}
{% set behind = th.node_behind_blocks | default(20) %}
{% set peers_message = th.peers_message_below | default(2) %}
{% set peers_page = th.peers_page_below | default(1) %}
{# NodePeersLow's words for a peer count below n: "no peers" below 1. #}
{% macro fewer(n) %}{{ 'no peers' if n | int == 1 else 'fewer than ' ~ n ~ ' peers' }}{% endmacro %}
{# celestia-appd hosts: the validator and the backup nodes. #}
{% set nodes = celestia_mon_appd_hosts %}
{% set fibres = groups.get('fibre', []) if fibre_on else [] %}
{% set kms = groups.get('kms', []) %}
{# KMS hosts whose node_exporter runs (celestia_mon_kms_scrape). Without one, nothing runs on the
   KMS host, and tmkms is seen only from the validator side: ValidatorNotSigning and the signer's
   failures. #}
{% set ns_kms = namespace(scraped=[]) %}
{% for h in kms %}
{%   if hostvars[h].celestia_mon_kms_scrape | default(false) | bool %}
{%     set ns_kms.scraped = ns_kms.scraped + [h] %}
{%   endif %}
{% endfor %}
{% set tensile_on = fibre_on and celestia_mon_tensile.validator | default('') | length > 0 %}
{% set signal_on = celestia_mon_signal | default({}, true) | length > 0 %}
{# The upgrade rules read the last value of each celestia-mon-signal metric in the past 7 days, as
   one sample without labels: a collector or RPC outage, or a scrape that stops, keeps the last
   reading instead of resolving an alert; SignalUnreadable reports the outage. Only the series of
   the current target count, so one left by an earlier host name cannot outweigh it. The quotes are
   PromQL's single ones, which the alert texts can hold. #}
{% macro last(m) %}max(last_over_time({{ m }}{job='signal',host='{{ celestia_mon_monitor_host }}'}[7d])){% endmacro %}
{# Alert template text that prints that value as a whole number (a version or a height). #}
{% macro number(m) %}{{ '{{' }} with query `{{ last(m) }}` }}{{ '{{' }} . | first | value | printf `%.0f` }}{{ '{{' }} end }}{% endmacro %}
{# Governance votes (GovVoteMissing), read with upgrade signalling unless celestia_mon_signal sets
   gov: false; the page only where celestia_mon_gov_page holds (by default chain_id celestia). #}
{% set gov_on = signal_on and celestia_mon_gov_on | bool %}
{% set gov_page = gov_on and celestia_mon_gov_page | bool %}
{# The vote rules read each proposal's last value in the past hour, by proposal_id: a scrape or two
   that fail keep the reading; an hour without one (the service down or not scraped) lets the alert
   resolve, after SignalUnreadable. While the service runs, it serves the proposals it read last,
   also while its reads of them fail. #}
{% macro gov(m) %}max by (proposal_id) (last_over_time({{ m }}{job='signal',host='{{ celestia_mon_monitor_host }}'}[1h])){% endmacro %}
{% set gov_end = gov('celestia_mon_gov_voting_end_timestamp_seconds') %}
{% set gov_span = '(' ~ gov_end ~ ' - ' ~ gov('celestia_mon_gov_voting_start_timestamp_seconds') ~ ')' %}
{# Alert template text: the proposal's title and the validator account, when they are read. #}
{% set gov_sel = "{job='signal',host='" ~ celestia_mon_monitor_host ~ "'" %}
{% set gov_title = "{{ with query (printf `max by (title) (last_over_time(celestia_mon_gov_proposal_info" ~ gov_sel
   ~ ",proposal_id='%s'}[1h]))` $labels.proposal_id) }}{{ with . | first | label `title` }} ({{ . }}){{ end }}{{ end }}" %}
{% set gov_voter = "{{ with query `max by (voter) (last_over_time(celestia_mon_gov_voting_proposals" ~ gov_sel
   ~ "}[1h]))` }} {{ . | first | label `voter` }}{{ end }}" %}
{% set vf = nodes + groups.get('fibre', []) %}
{# MonitorCannotReach: the scrape targets on the Celestia hosts (celestia-appd's metrics,
   node_exporter, the collector) that the monitor reaches over the network, so every host but the
   monitor's own. The monitor's own jobs, blackbox's probes of Fibre and the node_exporter of a
   monitor that runs no Celestia service answer locally and are left out. A per-host message
   stands in for that host's ServiceDown (unreachable) messages when none of its targets answers.
   Only where the monitor runs no Celestia service (mon_only) can it lose every host at once:
   then a page stands in for NodeNotAdvancing's "no height" branch and FibreDown's unit branch,
   which hold back while no target answers, so one cause pages once. #}
{% set mon = celestia_mon_monitor_host %}
{% set mon_only = mon not in (vf + ns_kms.scraped) %}
{% set remote_hosts = (vf + ns_kms.scraped) | unique | reject('equalto', mon) | list %}
{% set reach = 'up{job=~"celestia-app|node|otelcol",host!="' ~ mon ~ '"}' %}
{% set host_unreached = 'max by (host) (' ~ reach ~ ') == 0' %}
{% set none_reached = 'max(' ~ reach ~ ') == 0' %}
{% set some_reached = 'max(' ~ reach ~ ') == 1' %}
{# ServiceDown per unit: (key, unit, hosts it must be loaded on). A Fibre unit may be a stopped
   standby, which systemd drops from its list once it is also disabled, so Fibre has only the
   crash loop rule; FibreDown covers "no Fibre runs". #}
{% set units = [('appd', appd, nodes)]
   + ([('tmkms', tmkms, ns_kms.scraped)] if remote and ns_kms.scraped else [])
   + ([('fibre', fibre, [])] if fibre_on else []) %}
{% set tmkms_first = 'Check journalctl -u ' ~ celestia_mon_units.tmkms ~ ' on the KMS host first. ' if remote else '' %}
{% set vns_text = tmkms_first ~ 'The chain moves but no node of this install has seen a signature from the validator for more than '
   ~ th.not_signing_blocks ~ ' blocks.' %}
{% set missed_ratio = th.signatures_missed_ratio | default(0.05) %}
{# The blocks each node counted as missed in the last hour (SignaturesMissed; gen_dashboard.py's
   MISSED_1H is the same text, which CI checks). The count is a counter without a _total suffix, so
   increase() over it carries a PromQL notice; this sums each minute's rise instead: the count now
   less its last value a minute before, or after a node restart, when the count starts again, its
   new value. A count with no earlier value in the hour (a fresh install, a gap over an hour) adds
   nothing, as in increase(). #}
{% set missed = 'cometbft_consensus_validator_missed_blocks{job="celestia-app"}' %}
{% set missed_before = 'last_over_time(' ~ missed ~ '[1h] offset 1m)' %}
{% set missed_1h = 'sum_over_time((' ~ missed ~ ' - ' ~ missed_before ~ ' >= 0 or ' ~ missed ~ ' * 1 < ' ~ missed_before ~ ')[1h:1m])' %}
{% set docs = 'https://github.com/s0urledd/celestia-validator-monitoring/blob/main/docs/alerts.md' %}
groups:
  - name: celestia_mon
    rules:
      # ServiceDown: celestia-appd, tmkms or a collector is down or not loaded, or a Celestia service
      # is crash looping. Always a message: the pages come from the alerts below, which follow the
      # roles when they move between hosts. A stopped Fibre unit is no ServiceDown (a standby is
      # stopped); FibreDown pages when no Fibre unit is active anywhere. When none of a host's
      # targets answers, MonitorCannotReach names the host once instead of the three below.
      - alert: ServiceDown
        expr: >-
          up{job="celestia-app"} == 0
{% if remote_hosts %}
          unless on (host) {{ host_unreached }}
{% endif %}
        for: 3m
        labels:
          severity: message
          unit: celestia_app
        annotations:
          summary: "{% raw %}celestia-app metrics are unreachable on {{ $labels.host }}{% endraw %}"
          description: "Prometheus has not reached the celestia-app metrics endpoint for 3 minutes."
          runbook: "{{ docs }}#servicedown"
      - alert: ServiceDown
        expr: >-
          up{job="node"} == 0
{% if remote_hosts %}
          unless on (host) {{ host_unreached }}
{% endif %}
        for: 3m
        labels:
          severity: message
          unit: node_exporter
        annotations:
          summary: "{% raw %}node_exporter is unreachable on {{ $labels.host }}{% endraw %}"
          description: "Prometheus has not reached node_exporter for 3 minutes; service and disk alerts for this host are blind."
          runbook: "{{ docs }}#servicedown"
{% if fibre_on %}
      - alert: ServiceDown
        expr: >-
          up{job="otelcol"} == 0
{% if remote_hosts %}
          unless on (host) {{ host_unreached }}
{% endif %}
        for: 3m
        labels:
          severity: message
          unit: otelcol
        annotations:
          summary: "{% raw %}otelcol is unreachable on {{ $labels.host }}{% endraw %}"
          description: "Prometheus has not reached the OpenTelemetry collector for 3 minutes; Fibre metrics are not collected."
          runbook: "{{ docs }}#servicedown"
{% endif %}
{% for key, name, hosts in units %}
{% if key != 'fibre' %}
      - alert: ServiceDown
        expr: node_systemd_unit_state{name="{{ name }}",state="active"} == 0
        for: 2m
        labels:
          severity: message
          unit: {{ key }}
        annotations:
          summary: "{% raw %}{{ $labels.name }} is not active on {{ $labels.host }}{% endraw %}"
          description: "systemd has not reported the unit as active for 2 minutes."
          runbook: "{{ docs }}#servicedown"
{% endif %}
      - alert: ServiceDown
        # increase() extrapolates to the window edges (2 restarts can read as 2.07); floor() counts whole restarts.
        expr: floor(increase(node_systemd_service_restart_total{name="{{ name }}"}[30m])) > {{ th.crashloop_restarts }}
        labels:
          severity: message
          unit: {{ key }}
        annotations:
          summary: "{% raw %}{{ $labels.name }} is crash looping on {{ $labels.host }}{% endraw %}"
          description: "systemd restarted the unit more than {{ th.crashloop_restarts }} times in 30 minutes."
          runbook: "{{ docs }}#servicedown"
{% for h in hosts if h in vf or hostvars[h].celestia_mon_kms_scrape | default(false) | bool %}
      - alert: ServiceDown
        expr: absent(node_systemd_unit_state{host="{{ h }}",name="{{ name }}"}) and on () up{job="node",host="{{ h }}"} == 1
        for: 2m
        labels:
          severity: message
          unit: {{ key }}
        annotations:
          summary: "{% raw %}{{ $labels.name }} is not loaded on {{ $labels.host }}{% endraw %}"
          description: "node_exporter lists no such unit: it is stopped and disabled, or the inventory names the wrong unit."
          runbook: "{{ docs }}#servicedown"
{% endfor %}
{% endfor %}
{% if remote_hosts %}

      # MonitorCannotReach: for 3 minutes Prometheus on the monitor has reached none of a host's
      # scrape targets (celestia-appd's metrics, node_exporter, the collector), the hold of ServiceDown
      # (unreachable), which it stands in for: the host is down, or the link to it is (WireGuard, the
      # provider's network), and the monitor cannot tell which. A message; the page alerts that
      # follow the roles page for what that host held (ValidatorNotSigning, FibreDown).
      - alert: MonitorCannotReach
        expr: >-
          {{ host_unreached }}
{% if mon_only %}
          unless on () {{ none_reached }}
{% endif %}
        for: 3m
        labels:
          severity: message
        annotations:
          summary: "{% raw %}Monitor cannot reach {{ $labels.host }}{% endraw %}"
          description: "For 3 minutes Prometheus on {{ mon }} has reached none of this host's metrics endpoints (celestia-appd, node_exporter, the OpenTelemetry collector): the host is down, the link between it and the monitor is, or each of those services stopped. Its service and disk alerts are blind until it answers again; this message stands in for its ServiceDown messages."
          runbook: "{{ docs }}#monitorcannotreach"
{% endif %}
{% if mon_only %}
      # No Celestia host answers: the monitor lost its link to all of them (its WireGuard, its data
      # centre's network), or every host is down. Its 3 minutes match NodeNotAdvancing's, whose
      # "no height" branch, like FibreDown's unit branch, needs a target that answers, so the two
      # never page for one cause; this page stands in for the per-host messages too.
      - alert: MonitorCannotReach
        expr: >-
          {{ none_reached }}
        for: 3m
        labels:
          severity: page
        annotations:
          summary: "Monitor cannot reach any server"
          description: "For 3 minutes Prometheus on {{ mon }} has reached no metrics endpoint on any Celestia host ({{ remote_hosts | join(', ') }}): the link between the monitor and the hosts is down, or every host is. No alert that reads the hosts' metrics can fire meanwhile. Check from outside first whether the validator still signs: an explorer shows its recent blocks."
          runbook: "{{ docs }}#monitorcannotreach"
{% endif %}

      # NodeNotAdvancing: no node of this install committed a new block for 3 minutes (the highest
      # height of all nodes did not change in 2 minutes, and that held for 1 more), or Prometheus
      # read no node's height for as long. It shows that nothing advances, not whether a node that
      # advances is at the network's head. A window with a single height (the first evaluation
      # after Prometheus starts, or the last height of a node that just stopped) shows no change
      # either way, so it needs two; a node that stopped is caught when its height leaves the window.
{% if mon_only %}
      # Reading no height counts only while a target on a Celestia host answers; while none does,
      # MonitorCannotReach pages instead.
{% endif %}
      - alert: NodeNotAdvancing
        expr: >-
          (changes(max(cometbft_consensus_height{job="celestia-app"})[2m:]) == 0
            and on () count_over_time(max(cometbft_consensus_height{job="celestia-app"})[2m:]) > 1)
          or sum(absent_over_time(cometbft_consensus_height{job="celestia-app"}[2m]))
{% if mon_only %}
          and on () {{ some_reached }}
{% endif %}
        for: 1m
        labels:
          severity: page
        annotations:
          summary: "No node is advancing"
          description: "No node of this install has committed a new block for 3 minutes, or Prometheus reads no node's height. Check status.celestia.org or an explorer first: the whole chain may have halted."
          runbook: "{{ docs }}#nodenotadvancing"

      # NodeBehind: one node lags the others of this install: more than {{ behind }} blocks behind the
      # highest node, or not advancing while another node advances, for 10 minutes. It catches a
      # backup node that could not take over signing. With a single node it cannot fire.
      - alert: NodeBehind
        expr: >-
          max(cometbft_consensus_height{job="celestia-app"}) - on () group_right cometbft_consensus_height{job="celestia-app"}
          > {{ behind }}
          or changes(cometbft_consensus_height{job="celestia-app"}[2m]) == 0
          and on () changes(max(cometbft_consensus_height{job="celestia-app"})[2m:]) > 0
        for: 10m
        labels:
          severity: message
        annotations:
          summary: "{% raw %}Node on {{ $labels.host }} is behind{% endraw %}"
          description: "For 10 minutes the node has been more than {{ behind }} blocks behind the highest node of this install, or has not advanced while another node did. A node that lags cannot take over signing."
          runbook: "{{ docs }}#nodebehind"

      # NodePeersLow: a node of this install has too few peers (cometbft_p2p_peers). A message when any
      # node, the validator node or a backup node, has had {{ fewer(peers_message) }} for 5 minutes: nodes
      # it peers with dropped, and it follows the chain only while a peer is left.
      # A page when the node the validator signs through has had {{ fewer(peers_page) }} for 1 minute:
      # it receives no blocks or votes, and the validator misses every block. That node is the
      # dashboard's signing_nodes() over 15 minutes: with a remote signer, the nodes whose privval
      # client signed a vote or a proposal; with a local key, the nodes whose last signed height
      # changed. A node cut off from the network stops signing within a round, so the page also holds
      # for a host whose page already fires while it still has too few peers: otherwise it would
      # resolve 15 minutes after the last signature, while the node is still cut off. No page while
      # another node with enough peers signs (signing_nodes() over 2 minutes): the validator signs
      # through that node, after a tmkms repoint or with tmkms signing through several nodes.
      - alert: NodePeersLow
        expr: cometbft_p2p_peers{job="celestia-app"} < {{ peers_message }}
        for: 5m
        labels:
          severity: message
        annotations:
          summary: "{% raw %}Node on {{ $labels.host }} has {% endraw %}{{ fewer(peers_message) }}"
          description: "For 5 minutes the node has had {{ fewer(peers_message) }} ({% raw %}{{ $value | printf `%.0f` }}{% endraw %} now): nodes it peers with are down or cannot reach it. While a peer is left the node still follows the chain; with none it receives no blocks or votes and falls behind. Check the nodes it peers with, this host's network, and persistent_peers in the node's config.toml."
          runbook: "{{ docs }}#nodepeerslow"
      - alert: NodePeersLow
        expr: >-
          cometbft_p2p_peers{job="celestia-app"} < {{ peers_page }}
          and on (host) (
{% if remote %}
            sum by (host) (increase(cometbft_privval_signing_latency_seconds_count{job="celestia-app",message_type=~"prevote|precommit|proposal"}[15m])) > 0
{% else %}
            max by (host) (changes(cometbft_consensus_validator_last_signed_height{job="celestia-app"}[15m])) > 0
{% endif %}
            or max by (host) (ALERTS{alertname="NodePeersLow",severity="page",alertstate="firing"})
          )
{% if remote %}
          unless on () count(sum by (host) (increase(cometbft_privval_signing_latency_seconds_count{job="celestia-app",message_type=~"prevote|precommit|proposal"}[2m])) > 0 unless on (host) cometbft_p2p_peers{job="celestia-app"} < {{ peers_page }})
{% else %}
          unless on () count(max by (host) (changes(cometbft_consensus_validator_last_signed_height{job="celestia-app"}[2m])) > 0 unless on (host) cometbft_p2p_peers{job="celestia-app"} < {{ peers_page }})
{% endif %}
        for: 1m
        labels:
          severity: page
        annotations:
          summary: "{% raw %}Node on {{ $labels.host }} has {% endraw %}{{ fewer(peers_page) }}"
          description: "For 1 minute the node the validator signs through has had {{ fewer(peers_page) }}: it receives no blocks or votes, and the validator misses every block until a peer connects. Check the nodes it peers with and this host's network first, then persistent_peers in the node's config.toml."
          runbook: "{{ docs }}#nodepeerslow"

      # ValidatorNotSigning: the chain moves but no node of this install sees the validator's key
      # sign, whichever node the signer is connected to. Only nodes that know the validator's key
      # export the last signed height, so the rule compares the highest height of all nodes with
      # the highest last signed height. When the signing node goes away or cannot be scraped, its
      # series go with it, and the alert fires until a node shows a signature again (for example
      # after tmkms is pointed at a backup node). A node that tmkms left keeps the key it last read
      # and reports the same signatures, so the description never guesses which node signs: it
      # names only the nodes Prometheus cannot reach, which may still be signing unseen.
      - alert: ValidatorNotSigning
        expr: >-
          max(cometbft_consensus_height{job="celestia-app"})
          - (max(cometbft_consensus_validator_last_signed_height{job="celestia-app"})
          or max(cometbft_consensus_height{job="celestia-app"}) * 0) > {{ th.not_signing_blocks }}
          and on () changes(max(cometbft_consensus_height{job="celestia-app"})[5m:]) > 0
        for: 2m
        labels:
          severity: page
        annotations:
          summary: "The validator is not signing"
{% if nodes | length > 1 %}
          description: "{{ vns_text }}{% raw %}{{ range query `up{job='celestia-app'} == 0` | sortByLabel `host` }} Prometheus cannot reach the node on {{ .Labels.host }}, so signatures made through it are not seen; an explorer shows whether blocks are missed.{{ end }}{% endraw %}"
{% else %}
          description: "{{ vns_text }}"
{% endif %}
          runbook: "{{ docs }}#validatornotsigning"

      # SignaturesMissed: the validator signs, but not every block, for example when signatures
      # time out now and then. Each node that knows the validator's key counts the committed blocks
      # that carry no signature of the validator (validator_missed_blocks, celestia-core
      # consensus/state.go recordMetrics); it reads them from the chain's commits, so a node that
      # tmkms left keeps counting. Per node, the misses of the last hour are compared with the blocks
      # it committed in that hour, and the highest share counts: the alert follows the signer between
      # nodes and names no host. The count appears at the first miss and restarts with the node;
      # the minute sums count the restart as a reset (missed_1h above). It reports a share of
      # blocks, never how far the validator is from being jailed.
      - alert: SignaturesMissed
        expr: >-
          max(max by (host) ({{ missed_1h }})
          > on (host) {{ missed_ratio }} * max by (host) (delta(cometbft_consensus_height{job="celestia-app"}[1h])))
        for: 10m
        labels:
          severity: message
        annotations:
          summary: "The validator misses signatures"
          description: "{{ tmkms_first }}For 10 minutes more than {{ '%g' | format(missed_ratio * 100) }}% of the blocks of the last hour have been committed without a signature from the validator."
          runbook: "{{ docs }}#signaturesmissed"
{% if remote and not multi %}

      # ValidatorSigningTwice: two nodes of this install keep receiving votes or proposals signed with
      # the validator's key from a remote signer. Two signers with one key can sign two different
      # votes for one height, a double sign that the chain slashes and tombstones. The histogram
      # counts only the signatures a node got back (celestia-core v0.42.3 privval/signer_client.go);
      # a node that tmkms left keeps the key it last read but gets none. A node counts once it got
      # signatures both in the last 2 minutes and in the 2 minutes before, so a tmkms repoint, after
      # which the node tmkms left gets none within 2 minutes, never matches (not even as pending), and
      # the alert fires about 3 minutes after a second signer started. Not rendered with
      # celestia_mon_signer_multi_node, where tmkms signs through several nodes on purpose.
      - alert: ValidatorSigningTwice
        expr: >-
          count(
            sum by (host) (increase(cometbft_privval_signing_latency_seconds_count{job="celestia-app",message_type=~"prevote|precommit|proposal"}[2m])) > 0
            and on (host) sum by (host) (increase(cometbft_privval_signing_latency_seconds_count{job="celestia-app",message_type=~"prevote|precommit|proposal"}[2m] offset 2m)) > 0
          ) > 1
        for: 1m
        labels:
          severity: page
        annotations:
          summary: "The validator signs through two nodes"
          description: "{% raw %}For about 3 minutes votes or proposals signed with the validator's key have reached more than one node: {{ range $i, $s := query `sum by (host) (increase(cometbft_privval_signing_latency_seconds_count{job='celestia-app',message_type=~'prevote|precommit|proposal'}[2m])) > 0` | sortByLabel `host` }}{{ if $i }}, {{ end }}{{ $s.Labels.host }}{{ end }}{% endraw %}. Two signers with one key can sign two different votes for one height, and the chain slashes such a double sign and tombstones the validator. Stop the signer that should not sign now, for example a second tmkms with the same key on a standby KMS host. If one tmkms signs through several nodes on purpose, set celestia_mon_signer_multi_node: true."
          runbook: "{{ docs }}#validatorsigningtwice"
{% endif %}
{% if remote %}

      # RemoteSignerProblem: the remote signer is too slow, or cannot sign proposals. Per node: the
      # series move with the signer. Only nodes that signed through the remote signer in the last
      # 5 minutes count: the median of a node that tmkms left stays at its last value.
      - alert: RemoteSignerProblem
        expr: >-
          cometbft_privval_signing_latency_median_seconds > {{ th.signer_median_seconds }}
          and on (host) sum by (host) (increase(cometbft_privval_signing_latency_seconds_count[5m])) > 0
        for: 15m
        labels:
          severity: message
        annotations:
          summary: "{% raw %}Remote signer on {{ $labels.host }} is slower than {% endraw %}{{ '%g' | format(th.signer_median_seconds * 1000) }} ms"
          description: "The median of the last 50 signatures has been above {{ '%g' | format(th.signer_median_seconds * 1000) }} ms for 15 minutes."
          runbook: "{{ docs }}#remotesignerproblem"
      - alert: RemoteSignerProblem
        expr: increase(cometbft_privval_signing_failures_total{message_type="proposal",reason!~"timeout|no_connection"}[6h]) > 0
        labels:
          severity: message
        annotations:
          summary: "{% raw %}Remote signer on {{ $labels.host }} fails to sign proposals{% endraw %}"
          description: "{% raw %}Proposal signing failed with reason {{ $labels.reason }} in the last 6 hours; votes may still succeed.{% endraw %}"
          runbook: "{{ docs }}#remotesignerproblem"
{% endif %}
{% if fibre_on %}

      # FibreDown: no Fibre unit has been active on any Fibre host for 10 minutes. A stopped standby
      # is normal; this pages only when none runs: Fibre stopped or crashed everywhere, the host of
      # the active Fibre down (its node_exporter goes with it) and no standby started, or
      # celestia_mon_units.fibre naming the wrong unit. A failover within 10 minutes pages nobody.
      # The branches after it look at the endpoint from outside, through Tensile, when it is set up.
{% if mon_only %}
      # While no target on a Celestia host answers, MonitorCannotReach pages instead.
{% endif %}
      - alert: FibreDown
        expr: >-
          (count(node_systemd_unit_state{name="{{ fibre }}",state="active"} == 1) or vector(0)) == 0
{% if mon_only %}
          and on () {{ some_reached }}
{% endif %}
        for: 10m
        labels:
          severity: page
        annotations:
          summary: "Fibre is not running on any host"
          description: "For 10 minutes no Fibre host ({{ fibres | sort | join(', ') }}) has reported {{ fibre }} as active: Fibre is stopped everywhere, the host of the active Fibre is down, or celestia_mon_units.fibre names the wrong unit."
          runbook: "{{ docs }}#fibredown"
{% if tensile_on %}

      # FibreDown, seen from outside: Tensile (celestia-mon-tensile) dials the Fibre endpoint
      # registered on chain from outside this install's networks. A running Fibre unit is not
      # enough when nobody can reach it: a closed port, an inbound outage at the provider, an
      # identity the validator's key does not endorse, or the wrong address on chain. Only checks
      # of the last 15 minutes count; TensileUnreadable reports a check that stopped.
      - alert: FibreDown
        expr: >-
          max by (endpoint) (celestia_mon_fibre_reachable) == 0
          and on () time() - max(celestia_mon_fibre_last_check_timestamp_seconds) < 900
        for: 10m
        labels:
          severity: page
          check: reachability
        annotations:
          summary: "{% raw %}Fibre at {{ $labels.endpoint }} is unreachable from outside{% endraw %}"
          description: "For 10 minutes Tensile's checks from outside have not completed a connection to the Fibre endpoint registered on chain (TCP, TLS and the validator's identity), so clients cannot fetch from it, although its unit may run. The dashboard's Fibre from outside tile shows the outcome of the last check."
          runbook: "{{ docs }}#fibredown"
      # The registration: none on chain (reason not_registered), or another endpoint than the one of
      # the host where Fibre runs (wrong_host). The reason gives the dashboard its words.
      - alert: FibreDown
        expr: max(celestia_mon_fibre_registered) == 0
        for: 10m
        labels:
          severity: page
          check: registration
          reason: not_registered
        annotations:
          summary: "No Fibre host is registered on chain"
          description: "For 10 minutes the chain has had no Fibre host for the validator in x/valaddr, so no client finds it. Register the active Fibre host: celestia-appd tx valaddr set-host <host:port> --from <validator account key>."
          runbook: "{{ docs }}#fibredown"
{%   for h in fibres %}
{%     set e = hostvars[h].celestia_mon_fibre_public_endpoint | default('') %}
{%     if e %}
      - alert: FibreDown
        expr: >-
          max by (endpoint) (celestia_mon_fibre_registered{endpoint!={{ e | to_json }}} == 1)
          and on () max(node_systemd_unit_state{host={{ h | to_json }},name="{{ fibre }}",state="active"}) == 1
        for: 10m
        labels:
          severity: page
          check: registration
          reason: wrong_host
        annotations:
          summary: "{% raw %}The chain points to {{ $labels.endpoint }}, but Fibre runs on {% endraw %}{{ h }}"
          description: "For 10 minutes Fibre has been active on {{ h }}, whose public endpoint is {{ e }}, while the chain registers another endpoint, so clients dial a host where this Fibre does not run (after a failover, set-host was not sent). Fix: celestia-appd tx valaddr set-host {{ e }} --from <validator account key>."
          runbook: "{{ docs }}#fibredown"
{%     endif %}
{%   endfor %}
{% endif %}

      # FibreBothActive: Fibre runs active-passive, but the Fibre unit has been active on more than
      # one host for 5 minutes.
      - alert: FibreBothActive
        expr: count(node_systemd_unit_state{name="{{ fibre }}",state="active"} == 1) > 1
        for: 5m
        labels:
          severity: message
        annotations:
          summary: "Fibre is active on more than one host"
          description: "For 5 minutes {{ fibre }} has been active on {% raw %}{{ range $i, $s := query `node_systemd_unit_state{name='{% endraw %}{{ fibre }}{% raw %}',state='active'} == 1` | sortByLabel `host` }}{{ if $i }}, {{ end }}{{ $s.Labels.host }}{{ end }}{% endraw %}. Fibre runs on one host at a time: stop the one that should be the standby."
          runbook: "{{ docs }}#fibrebothactive"

      # FibreNotServing: Fibre runs but does not do its job: it misses blobs sent to the validator,
      # fails every upload, does not serve rows it signed for, reports itself not ready, or sends no
      # metrics. A network that sends no blobs never fires it. Only the host whose Fibre unit is
      # active can match: a stopped unit reports a start time of 0, and a standby sends no Fibre
      # metrics and does not answer the health check.
{% if tensile_on %}
      # Uploads missed: blobs came for the validator, but Fibre accepted none of them. Tensile records
      # each settled blob that assigned rows to the validator. The publisher's client sends an upload
      # to every validator the blob assigns rows to, never skipping one (celestia-app
      # fibre/client_upload.go: uploadShards starts one uploadTo per assigned validator), and once
      # 2/3 of the voting power has signed it keeps delivering to the rest in the background, each
      # upload bounded by the client's RPC timeout and retries (ClientConfig.DetachBackgroundUploads).
      # So the newest assignment settling more than 5 minutes after Fibre's last accepted upload is
      # an upload that never arrived or never completed, whether or not the validator's signature
      # made it into the blob.
      # Fibre's side is the later of its last accepted upload and the start of its unit: a blob that
      # settled while no Fibre ran, or before a restart, does not count, also while the collector
      # still holds the old process's last upload (for about 5 minutes after a restart). Tensile's
      # side is read as it was a minute ago, so a blob is compared only once Fibre's own report of
      # that upload has arrived (under 20 s after the upload here): no moment of the condition while
      # the two reports cross. Without blobs neither time moves, so a quiet network cannot fire it.
      # The last blob Tensile reported keeps counting while Tensile is not read (TensileUnreadable
      # reports that); it can only end the condition, never start one. Only a host whose Fibre unit
      # is active and sends Fibre metrics matches (no_telemetry covers the rest).
      - alert: FibreNotServing
        expr: >-
          max(celestia_mon_fibre_last_assigned_timestamp_seconds offset 1m)
          - on () group_right max by (host) (fibre_server_upload_shard_last_success_timestamp_seconds
          or node_systemd_unit_start_time_seconds{name="{{ fibre }}"})
          > 300
          and on (host) max by (host) (node_systemd_unit_state{name="{{ fibre }}",state="active"}) == 1
          and on (host) count by (host) (fibre_server_upload_shard_budget_bytes)
        for: 5m
        labels:
          severity: message
          reason: missed_uploads
        annotations:
          summary: "{% raw %}Fibre on {{ $labels.host }} missed uploads of blobs sent to the validator{% endraw %}"
          description: "{% raw %}For 5 minutes the newest blob that assigned rows to the validator, in Tensile's record, has settled {{ $value | humanizeDuration }} after Fibre last accepted an upload (or started, if it has accepted none since): the network sends blobs and this Fibre did not take that one. Publishers send every blob to every validator it assigns rows to, also after 2/3 have signed. Fibre's log names the cause; check first that the chain registers this host and that its port answers from outside.{% endraw %}"
          runbook: "{{ docs }}#fibrenotserving"
      # Rows not served: Tensile read rows of a blob the validator signed for, while Fibre must still
      # keep them, and Fibre did not return them, so clients cannot fetch the validator's share of
      # that blob. Tensile reads each settled blob once, late in the retention window, from one place,
      # and counts the failed reads of its last 24 hours, so a new one shows as a rise from one minute
      # to the next (a reading that leaves the 24 hours lowers the count). One failed read alone can
      # be a network blip between Tensile and the host: the alert needs a second failed read within
      # 24 hours. It fires at the rise that makes at least two, resolves an hour after the last such
      # rise, and names the host whose Fibre runs now.
      - alert: FibreNotServing
        expr: >-
          max by (host) (node_systemd_unit_state{name="{{ fibre }}",state="active"} == 1)
          and on () max_over_time((max(celestia_mon_fibre_obligations_24h{outcome="broken"})
          - max(celestia_mon_fibre_obligations_24h{outcome="broken"} offset 1m) > 0
          and max(celestia_mon_fibre_obligations_24h{outcome="broken"}) >= 2)[1h:1m])
        labels:
          severity: message
          reason: not_served
        annotations:
          summary: "{% raw %}Fibre on {{ $labels.host }} did not serve rows the validator signed for{% endraw %}"
          description: "{% raw %}In the last hour Tensile could not read rows of a blob the validator signed for, within the time Fibre must keep them, so clients could not fetch the validator's share of it; that makes {{ with query `max(celestia_mon_fibre_obligations_24h{outcome='broken'})` }}{{ . | first | value | printf `%.0f` }}{{ end }} failed reads in Tensile's last 24 hours (one alone does not fire this). Fibre's log names a store error (failed to retrieve blob shard); check the Fibre store's disk and its failed clean-ups.{% endraw %}"
          runbook: "{{ docs }}#fibrenotserving"
{% endif %}
      # Every upload fails and none is accepted. Fibre fetches the validator's public key for each
      # upload and then signs through the node at its signer_grpc_address (celestia-app
      # fibre/server_upload.go). An unreachable signer fails the upload before the signature is
      # tried, so fibre.server.sign.duration does not count it; the upload count with success
      # "false" counts both. Uploads that clients get wrong fail too, but next to accepted ones.
      - alert: FibreNotServing
        expr: >-
          sum by (host) (increase(fibre_server_upload_shard_duration_seconds_count{success="false"}[5m])) > 0
          unless on (host) sum by (host) (increase(fibre_server_upload_shard_duration_seconds_count{success="true"}[5m])) > 0
        for: 10m
        labels:
          severity: message
          reason: uploads_failing
        annotations:
          summary: "{% raw %}Fibre on {{ $labels.host }} fails every upload{% endraw %}"
          description: "For 15 minutes Fibre has accepted no upload while uploads kept failing, so it signs nothing. Check the signer first: Fibre signs through the node at its signer_grpc_address, so after tmkms is pointed at another node, point Fibre at that node too. Fibre's log names the error."
          runbook: "{{ docs }}#fibrenotserving"
      # Not ready: Fibre's own gRPC health check (service "") answers NOT_SERVING. Fibre answers
      # SERVING only while six checks pass, run every 10 seconds by default (celestia-app v10.5.0
      # fibre/server_health.go): app (the app node answers on the expected chain, is not syncing,
      # and its newest block is younger than max_block_age, 2 minutes by default), fibre_module
      # (the app node has the Fibre module), signer (the signer answers with the public key Fibre
      # started with), validator (in the active set), registration (a valid provider host on chain)
      # and store (a small write and read). Uploads do not read the state, but they need what the
      # checks test. Fibre logs each failing check with what to do and never serves it, so the probe
      # reads the state alone (job fibre_health, the blackbox exporter's grpc prober). Fibre answers
      # NOT_SERVING from its start until the first round passes and while it shuts down: the
      # 3 minutes let a restart pass. A Fibre older than v10.5.0 answers Unimplemented (status code
      # 12) and a stopped standby does not answer (14, every serving_status 0): neither matches. The
      # page follows at 10 minutes, FibreDown's delay. ValidatorNotSigning holds both back
      # (Alertmanager): a validator out of the active set or a dead signer is one cause.
{% set not_ready_text = " Fibre's own health check has answered NOT_SERVING, so at least one of its six checks fails: app (the app node answers on the right chain, synced, with a recent block), fibre_module, signer (answers with the key Fibre started with), validator (in the active set), registration (a valid provider host on chain) or store (a small write and read). Uploads to it may fail. Fibre's log names the check and what to do: journalctl -u " ~ fibre ~ " | grep 'health check failed'." %}
      - alert: FibreNotServing
        expr: max by (host) (probe_grpc_healthcheck_response{job="fibre_health",serving_status="NOT_SERVING"}) == 1
        for: 3m
        labels:
          severity: message
          reason: not_ready
        annotations:
          summary: "{% raw %}Fibre on {{ $labels.host }} is not ready for uploads{% endraw %}"
          description: "For 3 minutes{{ not_ready_text }}"
          runbook: "{{ docs }}#fibrenotserving"
      - alert: FibreNotServing
        expr: max by (host) (probe_grpc_healthcheck_response{job="fibre_health",serving_status="NOT_SERVING"}) == 1
        for: 10m
        labels:
          severity: page
          reason: not_ready
        annotations:
          summary: "{% raw %}Fibre on {{ $labels.host }} is not ready for uploads{% endraw %}"
          description: "For 10 minutes{{ not_ready_text }}"
          runbook: "{{ docs }}#fibrenotserving"
{% for h in fibres %}
      - alert: FibreNotServing
        expr: >-
          absent(fibre_server_upload_shard_budget_bytes{host="{{ h }}"})
          and on () node_systemd_unit_state{host="{{ h }}",name="{{ fibre }}",state="active"} == 1
        for: 30m
        labels:
          severity: message
          reason: no_telemetry
        annotations:
          summary: "{% raw %}Fibre on {{ $labels.host }} sends no metrics{% endraw %}"
          description: "The Fibre unit is active but no Fibre metrics have arrived for 30 minutes; set its OTLP endpoint."
          runbook: "{{ docs }}#fibrenotserving"
{% endfor %}
{% endif %}

      # DiskLow: a watched disk is filling up or turned read-only. Data mounts page on celestia-appd
      # hosts (validator and backup nodes) and kms hosts, and send messages on Fibre-only hosts and
      # on a monitor host that runs no Celestia service (the disk of Prometheus's data). The Fibre
      # store has its own rules unless it is also a node data mount. Each mount gets one set of
      # rules.
{% for h in (vf + kms + [mon]) | unique if h in vf or h == mon or hostvars[h].celestia_mon_kms_scrape | default(false) | bool %}
{% set node_host = h in nodes or h in kms %}
{% set store = hostvars[h].celestia_mon_fibre_mount | default('') if h in fibres else '' %}
{% for m in hostvars[h].celestia_mon_data_mounts | default([]) if node_host or m != store %}
{% if node_host %}
      - alert: DiskLow
        expr: >-
          node_filesystem_readonly{host="{{ h }}",mountpoint="{{ m }}"} == 1
          or node_filesystem_avail_bytes{host="{{ h }}",mountpoint="{{ m }}"} / node_filesystem_size_bytes{host="{{ h }}",mountpoint="{{ m }}"}
          < {{ th.disk_page_free_ratio }}
        labels:
          severity: page
        annotations:
          summary: "{% raw %}{{ $labels.mountpoint }} on {{ $labels.host }} is read-only or almost full{% endraw %}"
          description: "The filesystem is read-only or has less than {{ '%g' | format(th.disk_page_free_ratio * 100) }}% free space."
          runbook: "{{ docs }}#disklow"
{% else %}
      - alert: DiskLow
        expr: node_filesystem_readonly{host="{{ h }}",mountpoint="{{ m }}"} == 1
        labels:
          severity: message
        annotations:
          summary: "{% raw %}{{ $labels.mountpoint }} on {{ $labels.host }} is read-only{% endraw %}"
          description: "The filesystem is read-only."
          runbook: "{{ docs }}#disklow"
{% endif %}
      - alert: DiskLow
        expr: >-
          node_filesystem_avail_bytes{host="{{ h }}",mountpoint="{{ m }}"} / node_filesystem_size_bytes{host="{{ h }}",mountpoint="{{ m }}"}
          < {{ th.disk_message_free_ratio }}
{% if not node_host %}
          unless node_filesystem_readonly{host="{{ h }}",mountpoint="{{ m }}"} == 1
{% endif %}
        for: 10m
        labels:
          severity: message
        annotations:
          summary: "{% raw %}{{ $labels.mountpoint }} on {{ $labels.host }} has little free space{% endraw %}"
          description: "Free space has been below {{ '%g' | format(th.disk_message_free_ratio * 100) }}% for 10 minutes."
          runbook: "{{ docs }}#disklow"
{% endfor %}
{% endfor %}
{% for h in fibres if hostvars[h].celestia_mon_fibre_mount | default('') %}
{% set m = hostvars[h].celestia_mon_fibre_mount %}
{% if not ((h in nodes or h in kms) and m in hostvars[h].celestia_mon_data_mounts | default([])) %}
      - alert: DiskLow
        expr: node_filesystem_readonly{host="{{ h }}",mountpoint="{{ m }}"} == 1
        labels:
          severity: message
        annotations:
          summary: "{% raw %}Fibre store {{ $labels.mountpoint }} on {{ $labels.host }} is read-only{% endraw %}"
          description: "Fibre cannot store new shards on a read-only filesystem."
          runbook: "{{ docs }}#disklow"
      - alert: DiskLow
        expr: >-
          node_filesystem_avail_bytes{host="{{ h }}",mountpoint="{{ m }}"} / node_filesystem_size_bytes{host="{{ h }}",mountpoint="{{ m }}"}
          < {{ th.disk_message_free_ratio }}
          unless on (host) max by (host) (fibre_server_upload_shard_budget_bytes) > 0
          unless node_filesystem_readonly{host="{{ h }}",mountpoint="{{ m }}"} == 1
        for: 10m
        labels:
          severity: message
        annotations:
          summary: "{% raw %}Fibre store {{ $labels.mountpoint }} on {{ $labels.host }} has little free space{% endraw %}"
          description: "Free space has been below {{ '%g' | format(th.disk_message_free_ratio * 100) }}% for 10 minutes and Fibre reports no storage budget."
          runbook: "{{ docs }}#disklow"
{% endif %}
      - alert: DiskLow
        expr: >-
          max by (host) (fibre_server_upload_shard_budget_bytes) - max by (host) (fibre_server_upload_shard_occupancy_bytes)
          > on (host) max by (host) (node_filesystem_avail_bytes{host="{{ h }}",mountpoint="{{ m }}"})
          and on (host) max by (host) (fibre_server_upload_shard_budget_bytes) > 0
        for: 30m
        labels:
          severity: message
        annotations:
          summary: "{% raw %}Fibre store on {{ $labels.host }} cannot hold the storage budget{% endraw %}"
          description: "For 30 minutes the room the Fibre budget still needs has exceeded the free space on {{ m }}."
          runbook: "{{ docs }}#disklow"
{% endfor %}

      # RaidDegraded: an md software RAID array runs on fewer disks than it needs: a disk failed or
      # dropped out, the array started without it, or a new disk is still being rebuilt. node_exporter's
      # mdadm collector reads /proc/mdstat, whose [2/1] gives the disks the array needs and the active
      # ones (node_md_disks_required, node_md_disks{state="active"}). A host without md has no such
      # series, and the monthly check and a resync keep [2/2], so neither fires it; a rebuild keeps
      # it firing until the array is whole again. A single failed scrape must not resolve it, which
      # would read as "the rebuild finished", hence keep_firing_for. A message on every host.
      - alert: RaidDegraded
        expr: node_md_disks_required{job="node"} - ignoring (state) node_md_disks{job="node",state="active"} > 0
        for: 5m
        keep_firing_for: 10m
        labels:
          severity: message
        annotations:
          summary: "{% raw %}RAID {{ $labels.device }} on {{ $labels.host }} is missing a disk{% endraw %}"
          description: "{% raw %}For 5 minutes the md software RAID array {{ $labels.device }} has run on fewer disks than it needs ({{ $value | printf `%.0f` }} missing): a disk failed or dropped out, the array started without it, or a new disk is still being rebuilt. The host still serves its data from the disks left, but one more failure loses it. cat /proc/mdstat shows which disk is missing ([U_]) and a rebuild's progress; mdadm --detail /dev/{{ $labels.device }} shows why. This alert resolves when the array is whole again.{% endraw %}"
          runbook: "{{ docs }}#raiddegraded"

      # ClockNotSynced: the kernel has reported the host's clock as not synchronised for an hour: its
      # maximum error (adjtimex's maxerror, node_timex_maxerror_seconds) is at 16 s, the kernel's
      # ceiling, the same test as timedatectl's NTPSynchronized and doctor check 9. chrony sets the
      # error at each clock update and 16 s while it has no usable source; systemd-timesyncd sets 0
      # at each correction; in between the kernel adds 0.5 ms a second, so 16 s comes about 9 hours
      # after the last correction. A clocksource switch or a step also sets 16 s until the daemon's
      # next update, hence the hour. Nothing fails yet, but the clock drifts freely: a node about 60 s
      # slow rejects every block (celestia-core v0.42.3), and a Fibre server about 2 minutes fast
      # reports itself not ready. A clock synchronised to a wrong source passes. A single failed
      # scrape must not resolve it, which would read as "time sync works again", hence
      # keep_firing_for.
      - alert: ClockNotSynced
        expr: node_timex_maxerror_seconds{job="node"} >= 16
        for: 1h
        keep_firing_for: 10m
        labels:
          severity: message
        annotations:
          summary: "{% raw %}Clock not synchronised on {{ $labels.host }}{% endraw %}"
          description: "For an hour the kernel has reported this host's clock as not synchronised: chrony or systemd-timesyncd has stopped correcting it, or has not corrected it since boot. Nothing fails yet, but the clock now drifts freely: a Celestia node whose clock falls about 60 seconds behind rejects every block, and a Fibre server whose clock runs about 2 minutes ahead reports itself not ready. Run chronyc tracking or timedatectl timesync-status, and allow outgoing NTP (UDP 123)."
          runbook: "{{ docs }}#clocknotsynced"

{% if celestia_mon_announcements | default([]) | length > 0 %}
      # AnnouncementsUnreadable: celestia-mon-announcements has not read a Discord channel for
      # 15 minutes (a revoked token, a lost permission, Discord unreachable), or it is down, so
      # Celestia's announcements would not reach you. The timestamp is 0 until the first read.
      - alert: AnnouncementsUnreadable
        expr: >-
          time() - celestia_mon_announcements_last_success_timestamp_seconds > 900
          or up{job="announcements"} == 0
        for: 10m
        labels:
          severity: message
          host: {{ celestia_mon_monitor_host | to_json }}
        annotations:
          summary: "Celestia announcements are not being read on {{ celestia_mon_monitor_host }}"
          description: >-
            celestia-mon-announcements has not read its Discord channel for 15 minutes, or it is down, so new
            announcements would not reach you. Run journalctl -u celestia-mon-announcements on the monitor: it
            names the cause and the fix.
          runbook: "{{ docs }}#announcementsunreadable"

{% endif %}
{% if tensile_on %}
      # TensileUnreadable: for 15 minutes celestia-mon-tensile has not read Tensile, or Tensile has
      # not checked the endpoint, or the service is down, for 10 minutes more. FibreDown counts only
      # checks of the last 15 minutes, so from then on it cannot see an endpoint that is unreachable
      # from outside, and FibreNotServing sees no new blob: the same 15 minutes start this alert.
      # Tensile checks every endpoint about every 5 minutes (at most 7 minutes apart in 2 days of
      # Mocha data), and the service reads it every minute.
      - alert: TensileUnreadable
        expr: >-
          time() - celestia_mon_tensile_last_success_timestamp_seconds > 900
          or time() - max(celestia_mon_fibre_last_check_timestamp_seconds) > 900
          or up{job="tensile"} == 0
        for: 10m
        labels:
          severity: message
          host: {{ celestia_mon_monitor_host | to_json }}
        annotations:
          summary: "Fibre is not checked from outside"
          description: "For 15 minutes celestia-mon-tensile has not read Tensile, Tensile has not checked the Fibre endpoint, or the service is down, so an endpoint unreachable from outside would not page, and blobs Fibre misses or rows it does not serve would not be reported. Run journalctl -u celestia-mon-tensile on the monitor: it names the cause."
          runbook: "{{ docs }}#tensileunreadable"

{% endif %}
{% if signal_on %}
      # UpgradeSignalMissing: a signalling round is open (voting power has signalled the next app
      # version, x/signal) but the validator's entry in the signal store is not that version, and no
      # upgrade is scheduled yet. Once one is, x/signal refuses signals (keeper.go SignalVersion), so
      # the page ends and UpgradeScheduled says whether the validator signalled. The version the
      # validator signalled is read from state, whoever sent the transaction (authz included). It
      # holds for 10 minutes, Prometheus's --rules.alert.for-grace-period: a shorter hold is not
      # restored after a restart of Prometheus, and the page would resolve and fire again.
      - alert: UpgradeSignalMissing
        expr: >-
          {{ last('celestia_mon_signal_tally_power') }} / {{ last('celestia_mon_signal_total_power') }} > 0
          and {{ last('celestia_mon_signal_validator_version') }} != {{ last('celestia_mon_signal_next_version') }}
          and {{ last('celestia_mon_upgrade_pending') }} == 0
        for: 10m
        labels:
          severity: page
        annotations:
          summary: "The validator has not signalled v{{ number('celestia_mon_signal_next_version') }}"
          description: "{% raw %}{{ $value | humanizePercentage }}{% endraw %} of the voting power has signalled app version {{ number('celestia_mon_signal_next_version') }}, the next one, and the validator has {{ '{{' }} with query `{{ last('celestia_mon_signal_validator_version') }} > 0` }}signalled v{% raw %}{{ . | first | value | printf `%.0f` }} instead{{ else }}not signalled it{{ end }}{% endraw %}. Once 5/6 of the voting power has signalled, anyone can schedule the upgrade, and from then on no more signals are accepted. Upgrade celestia-appd on every node to a release that supports v{{ number('celestia_mon_signal_next_version') }}, then signal from the validator's account: celestia-appd tx signal signal {{ number('celestia_mon_signal_next_version') }} --from <validator account key>. If this alert resolves before you signal, the upgrade was scheduled: see UpgradeScheduled."
          runbook: "{{ docs }}#upgradesignalmissing"

      # UpgradeScheduled: 5/6 of the voting power signalled, and the upgrade is scheduled at a height
      # (GetUpgrade, which already counts the network's delay). Sent at once on its own route in
      # Alertmanager, and again after 4 days while it lasts (mainnet's delay is about a week); it
      # resolves when the chain has switched, as x/signal then clears the upgrade.
      - alert: UpgradeScheduled
        expr: >-
          {{ last('celestia_mon_upgrade_version') }}
          and {{ last('celestia_mon_upgrade_pending') }} == 1
        labels:
          severity: message
        annotations:
          summary: "{% raw %}Network upgrade to v{{ $value | printf `%.0f` }} scheduled{% endraw %}"
          description: "{% raw %}At least 5/6 of the voting power signalled app version {{ $value | printf `%.0f` }}, and the upgrade is scheduled at height {% endraw %}{{ number('celestia_mon_upgrade_height') }}{{ '{{' }} with query `{{ last('celestia_mon_upgrade_eta_seconds') }}` }}, in about {% raw %}{{ . | first | value | humanizeDuration }}{% endraw %}{{ '{{' }} with query `{{ last('celestia_mon_chain_block_time_seconds') }}` }} at the measured {% raw %}{{ . | first | value | printf `%.2f` }} s per block{{ end }}{{ end }}{% endraw %}. {{ '{{' }} with query `{{ last('celestia_mon_signal_validator_version') }} == {{ last('celestia_mon_upgrade_version') }}` }}{% raw %}Your validator signalled it.{{ else }}Your validator did not signal it, and signals are no longer accepted.{{ end }} Every node of this install must run a celestia-app release that supports v{{ $value | printf `%.0f` }} by then, or it stops at that height. This alert resolves when the chain has switched to v{{ $value | printf `%.0f` }}.{% endraw %}"
          runbook: "{{ docs }}#upgradescheduled"

      # UpgradeSoon: the scheduled upgrade is less than a day away at the measured block time. Sent
      # once, on UpgradeScheduled's route. The ETA follows the block time, which a few slow blocks
      # raise, so once the alert fires it stays (its own ALERTS series) until the chain has switched:
      # an ETA back above a day would otherwise resolve it and send it again.
      - alert: UpgradeSoon
        expr: >-
          (
            {{ last('celestia_mon_upgrade_eta_seconds') }} < 86400
            or max(ALERTS{alertname="UpgradeSoon",alertstate="firing"})
          )
          and {{ last('celestia_mon_upgrade_pending') }} == 1
        labels:
          severity: message
        annotations:
          summary: "Network upgrade to v{{ number('celestia_mon_upgrade_version') }} in less than a day"
          description: "The upgrade to app version {{ number('celestia_mon_upgrade_version') }} is scheduled at height {{ number('celestia_mon_upgrade_height') }}, in about {{ '{{' }} with query `{{ last('celestia_mon_upgrade_eta_seconds') }}` }}{% raw %}{{ . | first | value | humanizeDuration }}{{ end }}{% endraw %}. Check now that every node of this install ({{ nodes | join(', ') }}) runs a celestia-app release that supports v{{ number('celestia_mon_upgrade_version') }}: a node without one stops at that height. This alert resolves when the chain has switched to v{{ number('celestia_mon_upgrade_version') }}."
          runbook: "{{ docs }}#upgradesoon"

{% if gov_on %}
      # GovVoteMissing: a governance proposal is in its voting period and the validator account (the
      # operator address's bytes as celestia1..., whose vote the tally reads for the validator) has
      # no vote on it, with less than 2 days left (the message) or less than 1 (the page), or less
      # than half the vote on a short one. One alert per proposal, its value the time left. Where it
      # pages, the message is held back once the page's time has come, unless it fires already (its
      # own ALERTS series), so the two never start together: a vote of 2 days or less, or one first
      # read in its last day (gov turned on then, or the readings back after more than an hour),
      # gets the page alone. It resolves when the vote is on chain, when voting has closed, or when
      # the end moves out: an expedited proposal that fails becomes a regular one, its votes wiped
      # (x/gov abci.go), and comes back as it nears its new end. Both hold for 10 minutes, the
      # for-grace-period.
      - alert: GovVoteMissing
        expr: >-
          {{ gov_end }} - time() > 0
          < on (proposal_id) clamp_max({{ gov_span }} / 2, 172800)
          and on (proposal_id) {{ gov('celestia_mon_gov_validator_voted') }} == 0
{% if gov_page %}
          unless on (proposal_id) (
            {{ gov_end }} - time() < on (proposal_id) clamp_max({{ gov_span }} / 2, 86400)
            unless on (proposal_id) ALERTS{alertname="GovVoteMissing",severity="message",alertstate="firing"}
          )
{% endif %}
        for: 10m
        labels:
          severity: message
        annotations:
          summary: "{% raw %}The validator has not voted on proposal {{ $labels.proposal_id }}{% endraw %}"
          description: "{% raw %}Proposal {{ $labels.proposal_id }}{% endraw %}{{ gov_title }}{% raw %} ends its voting period in about {{ $value | humanizeDuration }}, and the validator account{% endraw %}{{ gov_voter }}{% raw %} has no vote on it. Vote from that account, abstain if you have no view rather than leave it empty: celestia-appd tx gov vote {{ $labels.proposal_id }} yes|no|no_with_veto|abstain --from <validator account key>. A vote sent through an authz grant from the validator account counts; a vote from any other account does not. This alert resolves when the vote is on chain or the voting period has ended.{% endraw %}{{ ' It pages when less than a day is left.' if gov_page else '' }}"
          runbook: "{{ docs }}#govvotemissing"

{% if gov_page %}
      - alert: GovVoteMissing
        expr: >-
          {{ gov_end }} - time() > 0
          < on (proposal_id) clamp_max({{ gov_span }} / 2, 86400)
          and on (proposal_id) {{ gov('celestia_mon_gov_validator_voted') }} == 0
        for: 10m
        labels:
          severity: page
        annotations:
          summary: "{% raw %}The validator has not voted on proposal {{ $labels.proposal_id }}{% endraw %}"
          description: "{% raw %}Proposal {{ $labels.proposal_id }}{% endraw %}{{ gov_title }}{% raw %} ends its voting period in about {{ $value | humanizeDuration }}, and the validator account{% endraw %}{{ gov_voter }}{% raw %} has no vote on it. Vote from that account, abstain if you have no view rather than leave it empty: celestia-appd tx gov vote {{ $labels.proposal_id }} yes|no|no_with_veto|abstain --from <validator account key>. A vote sent through an authz grant from the validator account counts; a vote from any other account does not. This alert resolves when the vote is on chain or the voting period has ended.{% endraw %}"
          runbook: "{{ docs }}#govvotemissing"

{% endif %}
{% endif %}
      # SignalUnreadable: for 15 minutes celestia-mon-signal has read none of its RPCs (each one down,
      # refused, behind, or serving another network), or with gov on none has given it the
      # proposals, or the service is down, for 10 minutes more. The upgrade alerts keep their last
      # reading meanwhile, and the vote alerts the proposals read last, which the service serves for
      # as long as it runs (the rules keep them an hour once it is down): a new signalling round
      # would not page, a new proposal would not be seen, and a vote cast meanwhile would not
      # resolve GovVoteMissing.
      - alert: SignalUnreadable
        expr: >-
          time() - celestia_mon_signal_last_success_timestamp_seconds > 900
{% if gov_on %}
          or time() - celestia_mon_gov_last_success_timestamp_seconds > 900
{% endif %}
          or up{job="signal"} == 0
        for: 10m
        labels:
          severity: message
          host: {{ celestia_mon_monitor_host | to_json }}
        annotations:
{% if gov_on %}
          summary: "The upgrade signal and votes are not being read on {{ celestia_mon_monitor_host }}"
          description: "For 15 minutes celestia-mon-signal has read none of its RPCs, none has given it the governance proposals, or it is down, so a new signalling round would not page, a new proposal would not be seen, and a vote cast meanwhile would not resolve GovVoteMissing. The upgrade alerts keep their last reading, and the vote alerts the proposals read last (for an hour only when the service is down). Run journalctl -u celestia-mon-signal on the monitor: it names each RPC that failed and why."
{% else %}
          summary: "The upgrade signal is not being read on {{ celestia_mon_monitor_host }}"
          description: "For 15 minutes celestia-mon-signal has read none of its RPCs, or it is down, so a new signalling round would not page, and the upgrade alerts keep their last reading. Run journalctl -u celestia-mon-signal on the monitor: it names each RPC that failed and why."
{% endif %}
          runbook: "{{ docs }}#signalunreadable"

{% endif %}
      # MonitoringBroken: Prometheus failed to evaluate alert rules, so some alerts cannot fire.
      - alert: MonitoringBroken
        expr: increase(prometheus_rule_evaluation_failures_total[10m]) > 0
        labels:
          severity: message
          host: {{ celestia_mon_monitor_host | to_json }}
        annotations:
          summary: "Prometheus on {{ celestia_mon_monitor_host }} fails to evaluate alert rules"
          description: "Rule evaluation failed in the last 10 minutes, so some alerts may not fire. The Prometheus log names the rule and the error."
          runbook: "{{ docs }}#monitoringbroken"

      # NotificationsFailing: Alertmanager could not deliver a page or message notification through one
      # integration (Telegram, Discord, Slack, PagerDuty or a webhook receiver). One alert per integration,
      # sent to the chat channels, so a broken one is reported through the others. Alertmanager labels
      # each failure with its receiver (receiver_name, from --enable-feature=receiver-name-in-metrics);
      # the dead-man receiver's failures are DeadmanFailing.
      - alert: NotificationsFailing
        expr: sum by (host, integration) (increase(alertmanager_notifications_failed_total{receiver_name!="deadman"}[15m])) > 0
        labels:
          severity: message
        annotations:
          summary: "{% raw %}Alertmanager on {{ $labels.host }} cannot deliver {{ $labels.integration }} notifications{% endraw %}"
          description: "{% raw %}A {{ $labels.integration }} notification failed in the last 15 minutes. Alerts reach you through your other receivers only.{% endraw %}"
          runbook: "{{ docs }}#notificationsfailing"

      # DeadmanFailing: Alertmanager could not deliver the heartbeat to the dead-man service: a wrong
      # URL, or no route to the service. A dead-man check that never got a heartbeat may never alert,
      # so this is the only signal of a URL that was wrong from the start.
      - alert: DeadmanFailing
        expr: sum by (host) (increase(alertmanager_notifications_failed_total{receiver_name="deadman"}[15m])) > 0
        labels:
          severity: message
        annotations:
          summary: "{% raw %}Alertmanager on {{ $labels.host }} cannot reach the dead-man service{% endraw %}"
          description: "A heartbeat to the dead-man service failed in the last 15 minutes. Until it gets through, the dead-man service cannot tell you that monitoring is down."
          runbook: "{{ docs }}#deadmanfailing"

      # Watchdog: the heartbeat for the dead-man service. It stops when monitoring is down, and for an
      # hour after a page or message notification failed through any receiver (Telegram, Discord, Slack,
      # PagerDuty or a webhook), so the dead-man service reports a broken alert channel through its own
      # channel, also when no other receiver can carry NotificationsFailing. Failed heartbeats
      # (receiver_name="deadman") do not stop it; DeadmanFailing reports them.
      - alert: Watchdog
        expr: vector(1) unless on () (sum(increase(alertmanager_notifications_failed_total{receiver_name!="deadman"}[1h])) > 0)
        labels:
          severity: heartbeat
        annotations:
          summary: "celestia-mon heartbeat"
          description: "Fires while monitoring runs and no page or message notification failed in the last hour. Only the dead-man service receives it, and it alerts when the heartbeats stop."
          runbook: "{{ docs }}#watchdog"
