{#
  Alertmanager configuration for celestia-mon. Rendered by the celestia_mon_alertmanager role (with no_log,
  because receivers carry tokens) and by CI with dummy receivers.
  Inputs: celestia_mon_receivers, one list of {type: pagerduty|telegram|discord|slack|webhook, ...}
  (checked by the role's tasks/receivers.yml), and celestia_mon_deadman_webhook_url.
  Routing follows the type: page alerts go to every receiver, message alerts to every receiver
  except PagerDuty. Without PagerDuty, page alerts still reach the chat channels and webhooks.
#}
{% set receivers = celestia_mon_receivers | default([], true) %}
{% set chat = receivers | rejectattr('type', 'equalto', 'pagerduty') | list %}
{% macro receiver_configs(entries) %}
{% for type in ['pagerduty', 'telegram', 'discord', 'slack', 'webhook'] %}
{%   set items = entries | selectattr('type', 'equalto', type) | list %}
{%   if items | length > 0 %}
    {{ type }}_configs:
{%     for r in items %}
{%       if type == 'pagerduty' %}
      - routing_key: {{ r.routing_key | string | to_json }}
{%       elif type == 'telegram' %}
      - bot_token: {{ r.bot_token | string | to_json }}
        chat_id: {{ r.chat_id | string | int }}
{%       elif type == 'discord' %}
      - webhook_url: {{ r.webhook_url | string | to_json }}
{%       elif type == 'slack' %}
      - api_url: {{ r.api_url | string | to_json }}
{%         if r.channel is defined %}
        channel: {{ r.channel | string | to_json }}
{%         endif %}
{%       else %}
      - url: {{ r.url | string | to_json }}
{%       endif %}
        send_resolved: true
{%     endfor %}
{%   endif %}
{% endfor %}
{% endmacro %}
# Managed by celestia-mon. Local changes are overwritten on the next playbook run.
route:
  receiver: message
  group_by: [alertname, host]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Heartbeat to the external dead-man service, every 1-2 minutes. Nothing else
    # sees it, and it never reaches the page or message receivers.
    - receiver: deadman
      matchers:
        - 'alertname="Watchdog"'
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1m
      continue: false
    - receiver: page
      matchers:
        - 'severity="page"'
    - receiver: message
      matchers:
        - 'severity="message"'

# One validator per install, so most rules need no 'equal' labels: one cause, one notification.
inhibit_rules:
  # A stalled node or a page-level service outage explains missed signatures,
  # signer trouble and an idle Fibre server.
  - source_matchers:
      - 'alertname="NodeNotAdvancing"'
    target_matchers:
      - 'alertname=~"ValidatorNotSigning|RemoteSignerProblem|FibreNotServing"'
  - source_matchers:
      - 'alertname="ServiceDown"'
      - 'severity="page"'
    target_matchers:
      - 'alertname=~"ValidatorNotSigning|RemoteSignerProblem|FibreNotServing"'
  # Fibre or its collector being down explains FibreNotServing.
  - source_matchers:
      - 'alertname="ServiceDown"'
      - 'unit=~"fibre|otelcol"'
    target_matchers:
      - 'alertname="FibreNotServing"'
  # Fibre being down explains FibreNotServing. There can be several Fibre hosts, so this
  # holds back only the same host's alert.
  - source_matchers:
      - 'alertname="FibreDown"'
    target_matchers:
      - 'alertname="FibreNotServing"'
    equal: [host]

receivers:
  # page: PagerDuty (when set) plus every chat channel and webhook.
  - name: page
{{ receiver_configs(receivers) }}
  # message: every chat channel and webhook, never PagerDuty.
  - name: message
{{ receiver_configs(chat) }}
  # Without a dead-man URL the heartbeat goes to this receiver and is dropped.
  - name: deadman
{% if celestia_mon_deadman_webhook_url | string | length > 0 %}
    webhook_configs:
      - url: {{ celestia_mon_deadman_webhook_url | string | to_json }}
        send_resolved: false
{% endif %}
