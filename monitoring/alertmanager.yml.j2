{#
  Alertmanager configuration for Taut. Rendered by the taut_alertmanager role (with no_log,
  because receivers carry tokens) and by CI with dummy receivers.
  Inputs: taut_receivers.page, taut_receivers.message (lists of {type: telegram|pagerduty|slack|webhook, ...})
  and taut_deadman_webhook_url. An empty list uses the other list's receivers, so no alert is dropped.
#}
{% set page = taut_receivers.page | default([], true) %}
{% set message = taut_receivers.message | default([], true) %}
{% macro receiver_configs(entries) %}
{% for type in ['telegram', 'pagerduty', 'slack', 'webhook'] %}
{%   set items = entries | selectattr('type', 'equalto', type) | list %}
{%   if items | length > 0 %}
    {{ type }}_configs:
{%     for r in items %}
{%       if type == 'telegram' %}
      - bot_token: {{ r.bot_token | string | to_json }}
        chat_id: {{ r.chat_id | string | int }}
{%       elif type == 'pagerduty' %}
      - routing_key: {{ r.routing_key | string | to_json }}
{%       elif type == 'slack' %}
      - api_url: {{ r.api_url | string | to_json }}
{%         if r.channel is defined %}
        channel: {{ r.channel | string | to_json }}
{%         endif %}
{%       else %}
      - url: {{ r.url | string | to_json }}
{%       endif %}
        send_resolved: true
{%     endfor %}
{%   endif %}
{% endfor %}
{% endmacro %}
# Managed by Taut. Local changes are overwritten on the next playbook run.
route:
  receiver: message
  group_by: [alertname, host]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Heartbeat to the external dead-man service, every 1-2 minutes. Nothing else
    # sees it, and it never reaches the page or message receivers.
    - receiver: deadman
      matchers:
        - 'alertname="Watchdog"'
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1m
      continue: false
    - receiver: page
      matchers:
        - 'severity="page"'
    - receiver: message
      matchers:
        - 'severity="message"'

# One validator per install, so the rules need no 'equal' labels: one cause, one notification.
inhibit_rules:
  # A stalled node or a page-level service outage explains missed signatures,
  # signer trouble and an idle Fibre server.
  - source_matchers:
      - 'alertname="NodeNotAtHead"'
    target_matchers:
      - 'alertname=~"ValidatorNotSigning|RemoteSignerProblem|FibreNotServing"'
  - source_matchers:
      - 'alertname="ServiceDown"'
      - 'severity="page"'
    target_matchers:
      - 'alertname=~"ValidatorNotSigning|RemoteSignerProblem|FibreNotServing"'
  # Fibre or its collector being down explains FibreNotServing.
  - source_matchers:
      - 'alertname="ServiceDown"'
      - 'unit=~"fibre|otelcol"'
    target_matchers:
      - 'alertname="FibreNotServing"'

receivers:
  # With no page receivers, page alerts go to the message receivers (and the other way round).
  - name: page
{{ receiver_configs(page or message) }}
  - name: message
{{ receiver_configs(message or page) }}
  # Without a dead-man URL the heartbeat goes to this receiver and is dropped.
  - name: deadman
{% if taut_deadman_webhook_url | string | length > 0 %}
    webhook_configs:
      - url: {{ taut_deadman_webhook_url | string | to_json }}
        send_resolved: false
{% endif %}
