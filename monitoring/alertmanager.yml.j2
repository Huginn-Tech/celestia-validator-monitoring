{#
  Alertmanager configuration for celestia-mon. Rendered by the celestia_mon_alertmanager role (with no_log,
  because receivers carry tokens) and by CI with dummy receivers.
  Inputs: celestia_mon_receivers, one list of {type: pagerduty|telegram|discord|slack|webhook, ...}
  (checked by the role's tasks/receivers.yml), and celestia_mon_deadman_webhook_url (checked by the
  role's tasks/main.yml).
  Routing follows the type: page alerts go to every receiver, message alerts to every receiver
  except PagerDuty. Without PagerDuty, page alerts still reach the chat channels and webhooks.
#}
{% set receivers = celestia_mon_receivers | default([], true) %}
{% set chat = receivers | rejectattr('type', 'equalto', 'pagerduty') | list %}
{% macro receiver_configs(entries, resolved=true) %}
{% for type in ['pagerduty', 'telegram', 'discord', 'slack', 'webhook'] %}
{%   set items = entries | selectattr('type', 'equalto', type) | list %}
{%   if items | length > 0 %}
    {{ type }}_configs:
{%     for r in items %}
{%       if type == 'pagerduty' %}
      - routing_key: {{ r.routing_key | string | to_json }}
{%       elif type == 'telegram' %}
      - bot_token: {{ r.bot_token | string | to_json }}
        chat_id: {{ r.chat_id | string | int }}
        message: '{% raw %}{{ template "celestia.telegram.message" . }}{% endraw %}'
{%       elif type == 'discord' %}
      - webhook_url: {{ r.webhook_url | string | to_json }}
        title: '{% raw %}{{ template "celestia.discord.title" . }}{% endraw %}'
        message: '{% raw %}{{ template "celestia.discord.message" . }}{% endraw %}'
{%       elif type == 'slack' %}
      - api_url: {{ r.api_url | string | to_json }}
{%         if r.channel is defined %}
        channel: {{ r.channel | string | to_json }}
{%         endif %}
{%       else %}
      - url: {{ r.url | string | to_json }}
{%       endif %}
        send_resolved: {{ resolved | to_json }}
{%     endfor %}
{%   endif %}
{% endfor %}
{% endmacro %}
# Managed by celestia-mon. Local changes are overwritten on the next playbook run.
# Telegram and Discord messages use celestia-mon's text (monitoring/alertmanager-templates.tmpl).
templates:
  - {{ (celestia_mon_alertmanager_templates_file | default('/etc/celestia-mon/alertmanager/celestia-mon.tmpl')) | to_json }}

route:
  receiver: message
  group_by: [alertname, host]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Heartbeat to the external dead-man service, every 1-2 minutes. Nothing else
    # sees it, and it never reaches the page or message receivers.
    - receiver: deadman
      matchers:
        - 'alertname="Watchdog"'
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1m
      continue: false
    # Celestia's announcements (celestia-mon-announcements): one notification per announcement,
    # sent at once and once only, through receivers that send no "resolved" message.
    - matchers:
        - 'alertname="CelestiaAnnouncement"'
      group_by: ['...']
      group_wait: 0s
      group_interval: 1m
      # Within the 120 hours Alertmanager keeps its notification log (a longer interval can repeat
      # sooner); an announcement is active for 30 minutes, so it is never sent twice.
      repeat_interval: 96h
      routes:
        - receiver: announcement-page
          matchers:
            - 'severity="page"'
        - receiver: announcement-message
          matchers:
            - 'severity="message"'
    - receiver: page
      matchers:
        - 'severity="page"'
    - receiver: message
      matchers:
        - 'severity="message"'

# One validator per install: one cause, one notification.
inhibit_rules:
  # No node advancing explains missed signatures, signer trouble, an idle Fibre server
  # and a node that lags the others.
  - source_matchers:
      - 'alertname="NodeNotAdvancing"'
    target_matchers:
      - 'alertname=~"ValidatorNotSigning|SignaturesMissed|RemoteSignerProblem|FibreNotServing|NodeBehind"'
  # Signatures that stopped altogether page once, without a message about the missed share too.
  # Neither alert names a host.
  - source_matchers:
      - 'alertname="ValidatorNotSigning"'
    target_matchers:
      - 'alertname="SignaturesMissed"'
  # No Fibre unit active anywhere explains FibreNotServing. FibreDown names no host.
  - source_matchers:
      - 'alertname="FibreDown"'
    target_matchers:
      - 'alertname="FibreNotServing"'
  # A crash-looping Fibre or a collector that is down explains the same host's FibreNotServing.
  - source_matchers:
      - 'alertname="ServiceDown"'
      - 'unit=~"fibre|otelcol"'
    target_matchers:
      - 'alertname="FibreNotServing"'
    equal: [host]

receivers:
  # page: PagerDuty (when set) plus every chat channel and webhook.
  - name: page
{{ receiver_configs(receivers) }}
  # message: every chat channel and webhook, never PagerDuty.
  - name: message
{{ receiver_configs(chat) }}
  - name: announcement-page
{{ receiver_configs(receivers, false) }}
  - name: announcement-message
{{ receiver_configs(chat, false) }}
  # A receiver of its own, so Alertmanager's notification metrics tell its sends and failures
  # apart (receiver_name="deadman", from --enable-feature=receiver-name-in-metrics). The install
  # refuses an empty or placeholder URL on the monitor host.
  - name: deadman
{% if celestia_mon_deadman_webhook_url | string | length > 0 %}
    webhook_configs:
      - url: {{ celestia_mon_deadman_webhook_url | string | to_json }}
        send_resolved: false
{% endif %}
