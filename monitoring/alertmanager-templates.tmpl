{{/*
  Notification text of celestia-mon for Telegram, Discord, Slack and PagerDuty, in place of
  Alertmanager's list of every label and annotation and its links. A Celestia announcement is its
  own text under the channel it came from; an alert is one line (state, alert, host) with its
  summary and description.
  Telegram uses parse mode HTML, so Alertmanager escapes the values and the tags below stay.
  Slack reads &, < and > as markup, so its templates escape them in every value.
*/}}

{{ define "celestia.state" }}{{ if eq .Status "resolved" }}✅ RESOLVED{{ else if eq .Labels.severity "page" }}🔴 PAGE{{ else }}🟡 MESSAGE{{ end }}{{ end }}

{{ define "celestia.telegram.message" }}
{{- range $i, $a := .Alerts }}{{ if $i }}

{{ end }}
{{- if eq $a.Labels.alertname "CelestiaAnnouncement" -}}
📣 <b>{{ $a.Labels.source }}</b>

{{ $a.Annotations.description }}
{{- else -}}
{{ template "celestia.state" $a }} · <b>{{ $a.Labels.alertname }}</b>{{ with $a.Labels.host }} · {{ . }}{{ end }}
{{ $a.Annotations.summary }}
{{- with $a.Annotations.description }}
{{ . }}{{ end }}
{{- end }}
{{- end }}
{{- end }}

{{ define "celestia.discord.title" }}
{{- with index .Alerts 0 }}
{{- if eq .Labels.alertname "CelestiaAnnouncement" }}📣 {{ .Labels.source }}
{{- else }}{{ template "celestia.state" . }} · {{ .Labels.alertname }}{{ with .Labels.host }} · {{ . }}{{ end }}
{{- end }}
{{- end }}
{{- end }}

{{ define "celestia.discord.message" }}
{{- range $i, $a := .Alerts }}{{ if $i }}

{{ end }}
{{- if eq $a.Labels.alertname "CelestiaAnnouncement" }}{{ $a.Annotations.description }}
{{- else }}{{ if $i }}{{ template "celestia.state" $a }} · {{ $a.Labels.alertname }}{{ with $a.Labels.host }} · {{ . }}{{ end }}
{{ end }}**{{ $a.Annotations.summary }}**
{{- with $a.Annotations.description }}
{{ . }}{{ end }}
{{- end }}
{{- end }}
{{- end }}

{{ define "celestia.slack.escape" }}{{ . | reReplaceAll "&" "&amp;" | reReplaceAll "<" "&lt;" | reReplaceAll ">" "&gt;" }}{{ end }}

{{ define "celestia.slack.title" }}
{{- with index .Alerts 0 }}
{{- if eq .Labels.alertname "CelestiaAnnouncement" }}📣 {{ template "celestia.slack.escape" .Labels.source }}
{{- else }}{{ template "celestia.state" . }} · {{ .Labels.alertname }}{{ with .Labels.host }} · {{ template "celestia.slack.escape" . }}{{ end }}
{{- end }}
{{- end }}
{{- end }}

{{ define "celestia.slack.text" }}
{{- range $i, $a := .Alerts }}{{ if $i }}

{{ end }}
{{- if eq $a.Labels.alertname "CelestiaAnnouncement" }}{{ template "celestia.slack.escape" $a.Annotations.description }}
{{- else }}{{ if $i }}{{ template "celestia.state" $a }} · {{ $a.Labels.alertname }}{{ with $a.Labels.host }} · {{ template "celestia.slack.escape" . }}{{ end }}
{{ end }}*{{ template "celestia.slack.escape" $a.Annotations.summary }}*
{{- with $a.Annotations.description }}
{{ template "celestia.slack.escape" . }}{{ end }}
{{- end }}
{{- end }}
{{- end }}

{{/* PagerDuty's incident title: the first alert's name, host and summary, and how many alerts the group holds. */}}
{{ define "celestia.pagerduty.description" }}
{{- with index .Alerts 0 }}
{{- if eq .Labels.alertname "CelestiaAnnouncement" }}{{ .Annotations.summary }}
{{- else }}{{ .Labels.alertname }}{{ with .Labels.host }} · {{ . }}{{ end }}: {{ .Annotations.summary }}
{{- end }}
{{- end }}
{{- if gt (len .Alerts) 1 }} ({{ len .Alerts }} alerts){{ end }}
{{- end }}

{{/* PagerDuty's details (firing, resolved): one line per alert, its name, host, summary and description. */}}
{{ define "celestia.pagerduty.alerts" }}
{{- range $i, $a := . }}{{ if $i }}
{{ end }}
{{- $a.Labels.alertname }}{{ with $a.Labels.host }} · {{ . }}{{ end }}: {{ $a.Annotations.summary }}
{{- with $a.Annotations.description }} {{ . }}{{ end }}
{{- end }}
{{- end }}
